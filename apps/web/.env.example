# Copy to .env and fill in. Validated at startup by
# packages/shared/src/config/schema.ts — see CLAUDE.md §4.2 and §13.
#
# Matches the local stack started by `pnpm dev:services`
# (docker-compose.yml). Values below are local-dev shaped, not secrets.

NODE_ENV=development

# Level of the process-wide logger (CAL-009).
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL — host port 5434 (see docker-compose.yml)
DATABASE_URL=postgresql://calepin:calepin@localhost:5434/calepin

# Redis
REDIS_URL=redis://localhost:6379

# How many generation jobs one worker process runs at once, per generation
# queue (CAL-065, split by mission profile in CAL-066). Not read by apps/web,
# but envSchema is one closed schema for every Calepin process. Optional —
# each defaults as shown if omitted.
GENERATION_FAST_WORKER_CONCURRENCY=12
GENERATION_SLOW_WORKER_CONCURRENCY=6
GENERATION_AUDIT_WORKER_CONCURRENCY=3

# How long a finished BullMQ job (completed or failed) is kept before the
# cleanup sweep purges it (CAL-069). `Generation` and `GenerationAttempt` stay
# in PostgreSQL regardless — this only bounds the transport envelope in Redis.
# Not read by apps/web. Optional — defaults as shown if omitted (a day, a week).
QUEUE_CLEANUP_COMPLETED_JOB_TTL_MS=86400000
QUEUE_CLEANUP_FAILED_JOB_TTL_MS=604800000

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=calepin
S3_ACCESS_KEY_ID=calepin
S3_SECRET_ACCESS_KEY=calepin_local

# Auth.js signing/encryption key (CAL-024). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-a-32-character-minimum-random-string

# SMTP server for the email sign-in link (CAL-025). Matches the mailpit
# service started by `pnpm dev:services` (docker-compose.yml) — web UI at
# http://localhost:8025 to read a local sign-in link.
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=calepin
EMAIL_SERVER_PASSWORD=calepin_local
EMAIL_FROM=connexion@calepin.test

# Google OAuth sign-in (CAL-026). Create credentials at
# https://console.developers.google.com/apis/credentials — authorized
# redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# GitHub OAuth sign-in (CAL-027). Create credentials at
# https://github.com/settings/developers — authorization callback URL:
# http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# The primary model provider (CAL-049, CAL-208). Create a key at
# https://console.anthropic.com/settings/keys. Required — every process
# validates the same closed schema, so a placeholder is enough to boot a shell
# that never calls a model.
ANTHROPIC_API_KEY=replace-me

# The fallback provider (CAL-050, CAL-208): the same models on Amazon Bedrock,
# under a different account and control plane. Optional as a group — set all
# three or none. With none, generations run on the primary endpoint alone and a
# provider outage is not survived; with two of three, the process refuses to
# start rather than lose the fallback silently.
# BEDROCK_REGION=eu-west-3
# BEDROCK_ACCESS_KEY_ID=replace-me
# BEDROCK_SECRET_ACCESS_KEY=replace-me
