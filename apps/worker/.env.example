# Copy to .env and fill in. Validated at startup by
# packages/shared/src/config/schema.ts — see CLAUDE.md §4.2.
#
# Matches the local stack started by `pnpm dev:services`
# (docker-compose.yml). Values below are local-dev shaped, not secrets.
#
# The worker reads only DATABASE_URL, REDIS_URL and LOG_LEVEL today, but
# `envSchema` is one closed schema for every Calepin process: a variable is
# either declared for all of them or for none, and a missing one fails at
# startup beside all the others rather than at the first line that reads it.
# In production these come from the process manager and this file is absent.

NODE_ENV=development

# Level of the process-wide logger (CAL-009).
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL — host port 5434 (see docker-compose.yml)
DATABASE_URL=postgresql://calepin:calepin@localhost:5434/calepin

# Redis — the queue the worker consumes
REDIS_URL=redis://localhost:6379

# How many generation jobs this worker runs at once, per generation queue
# (CAL-065, split by mission profile in CAL-066). Optional — each defaults as
# shown if omitted. The real cap on concurrent generations is the per-user
# and per-project limit enforced at the claim; these are only the
# process-level ceiling above it, one per queue.
GENERATION_FAST_WORKER_CONCURRENCY=12
GENERATION_SLOW_WORKER_CONCURRENCY=6
GENERATION_AUDIT_WORKER_CONCURRENCY=3

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=calepin
S3_ACCESS_KEY_ID=calepin
S3_SECRET_ACCESS_KEY=calepin_local

# Auth.js signing/encryption key (CAL-024). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-a-32-character-minimum-random-string

# SMTP server for the email sign-in link (CAL-025). Matches the mailpit
# service started by `pnpm dev:services` (docker-compose.yml).
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=calepin
EMAIL_SERVER_PASSWORD=calepin_local
EMAIL_FROM=connexion@calepin.test

# Google OAuth sign-in (CAL-026).
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# GitHub OAuth sign-in (CAL-027).
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
