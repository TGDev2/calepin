generator client {
  provider        = "prisma-client-js"
  // relationJoins (CAL-032): lets a nested read ask for `relationLoadStrategy:
  // "join"`, compiling to one SQL statement instead of one query per relation
  // level — the dashboard's own query needs the literal single round trip,
  // not merely the N+1 Prisma's default batching already avoids.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// The audit block (CAL-022)
//
// Every model below that carries `updatedAt` also carries `updatedById`,
// `updatedBy` and `version`. The three go together and the rule behind them is
// mechanical rather than a judgement call: a row that can be modified must
// record who modified it last, and a counter is only meaningful where there is
// a second state to count. A model *without* `updatedAt` is append-only — it is
// written once, and its author is already its creator
// (`AnalysisSectionRevision.createdById`, `ChapterRevision.createdById`,
// `SourceTextVersion.editedById`) or it is a join row asserting nothing of its
// own. `prisma/schema.test.ts` pins that rule against
// `@calepin/shared/audit`'s registry, so a model added later with `updatedAt`
// and no audit block fails there instead of shipping untraceable.
//
// `User` is the one deliberate exception: the author of a change to an account
// is the account holder, which is the row's own `id`.
//
// `updatedById` is NOT NULL, which is what makes an unattributed row unwritable
// even through raw SQL or a nested write — neither of which a Prisma client
// extension can see. The extension in `@calepin/shared/audit` fills the column
// from the request context and fails early and readably; this column is what
// makes the guarantee unconditional.
//
// **The `"unattributed"` default is a sentinel, and it is deliberate.** Without
// a default, Prisma makes `updatedById` a required member of every model's
// create input, so no business code could ever *not* name the author — and an
// extension that fills a field the compiler already demands is decoration. The
// default takes the column out of the caller's contract. It can never be
// stored: no `User` has that id, the foreign key refuses it, and
// `users_id_attributable_check` keeps one from being created. A write that
// escapes the extension therefore fails on the foreign key, naming the sentinel
// — a better message than a NOT NULL violation, since it says what went wrong
// rather than only that something is missing.
//
// **`onDelete: NoAction`, and the foreign key is DEFERRABLE INITIALLY DEFERRED
// in the migration** — probed, not assumed, and the first two answers were
// wrong. RESTRICT is checked immediately and refused the deletion of an account
// over rows the account's own `projects` cascade was about to remove. NO ACTION
// defers to the end of the *statement*, which holds at one level of cascade and
// breaks at two (`users` → `projects` → `bibles`): the deeper cascade is queued
// behind the check that reads the rows it is about to delete. Deferring to
// COMMIT is the only form that holds at any depth, and it is the honest one —
// "no row names an author who does not exist" is an invariant of the
// transaction. A row written by *another* user inside someone else's project is
// still refused, which is the property that matters: an audit trail must not be
// silently orphaned. Prisma cannot express deferrability, so the migration
// writes those foreign keys by hand; introspection ignores it, so there is no
// drift.
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(cuid())
  email String @unique

  /// Optional since CAL-024: an account created from an email link knows an
  /// address and nothing else. The adapter writes whatever the provider
  /// returned, and a required column would make the first sign-in fail.
  name String?

  /// When the address was proven to belong to the account holder — Auth.js
  /// sets it, and CAL-026 reads it to decide whether an OAuth identity may be
  /// attached to an existing account. A timestamp rather than a boolean, for
  /// the reason `validatedAt` is one everywhere else in this schema.
  emailVerified DateTime?

  /// The avatar URL a provider supplied. Never fetched, never proxied.
  image String?

  /// This user's own override of how many generations may run at once across
  /// every project they own (CAL-065), when it is not the system default —
  /// `DEFAULT_USER_GENERATION_CONCURRENCY_LIMIT` in
  /// @calepin/shared/generation. The same nullable-override shape
  /// `Generation.attemptCeiling` already uses, and enforced the same way: at
  /// the claim, under the row's own lock — see users_generation_concurrency_limit_check.
  generationConcurrencyLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  projects                    Project[]                 @relation("ProjectOwner")
  sourceTextVersionsEdited    SourceTextVersion[]
  analysesValidated           Analysis[]                @relation("AnalysisValidatedBy")
  analysisRevisionsCreated    AnalysisSectionRevision[]
  analysisAnnotations         AnalysisAnnotation[]      @relation("AnalysisAnnotationAuthor")
  biblesValidated             Bible[]                   @relation("BibleValidatedBy")
  directionEvaluationsCreated DirectionEvaluation[]
  chapterRevisionsCreated     ChapterRevision[]
  chapterSummariesCreated     ChapterSummaryRevision[]
  partSummariesCreated        PartSummaryRevision[]
  exportsRequested            Export[]                  @relation("ExportRequestedBy")

  /// The audit trail (CAL-022): every mutable row this account last modified.
  /// One field per audited model, because Prisma requires the opposite side of
  /// every relation to be declared; nothing reads them individually.
  projectsUpdated                  Project[]                  @relation("ProjectUpdatedBy")
  sourceTextsUpdated               SourceText[]               @relation("SourceTextUpdatedBy")
  analysesUpdated                  Analysis[]                 @relation("AnalysisUpdatedBy")
  analysisAnnotationsUpdated       AnalysisAnnotation[]       @relation("AnalysisAnnotationUpdatedBy")
  creativeDirectionsUpdated        CreativeDirection[]        @relation("CreativeDirectionUpdatedBy")
  biblesUpdated                    Bible[]                    @relation("BibleUpdatedBy")
  bibleIdentitiesUpdated           BibleIdentity[]            @relation("BibleIdentityUpdatedBy")
  bibleStylesUpdated               BibleStyle[]               @relation("BibleStyleUpdatedBy")
  charactersUpdated                Character[]                @relation("CharacterUpdatedBy")
  relationshipsUpdated             Relationship[]             @relation("RelationshipUpdatedBy")
  placesUpdated                    Place[]                    @relation("PlaceUpdatedBy")
  worldRulesUpdated                WorldRule[]                @relation("WorldRuleUpdatedBy")
  timelineEventsUpdated            TimelineEvent[]            @relation("TimelineEventUpdatedBy")
  timelineEventParticipantsUpdated TimelineEventParticipant[] @relation("TimelineEventParticipantUpdatedBy")
  canonFactsUpdated                CanonFact[]                @relation("CanonFactUpdatedBy")
  canonFactBeliefsUpdated          CanonFactBelief[]          @relation("CanonFactBeliefUpdatedBy")
  canonFactSubjectsUpdated         CanonFactSubject[]         @relation("CanonFactSubjectUpdatedBy")
  outlinesUpdated                  Outline[]                  @relation("OutlineUpdatedBy")
  partsUpdated                     Part[]                     @relation("PartUpdatedBy")
  chaptersUpdated                  Chapter[]                  @relation("ChapterUpdatedBy")
  chapterOutlinesUpdated           ChapterOutline[]           @relation("ChapterOutlineUpdatedBy")
  threadsUpdated                   Thread[]                   @relation("ThreadUpdatedBy")
  generationsUpdated               Generation[]               @relation("GenerationUpdatedBy")
  qualityIssuesUpdated             QualityIssue[]             @relation("QualityIssueUpdatedBy")
  exportsUpdated                   Export[]                   @relation("ExportUpdatedBy")
  publicationsUpdated              Publication[]              @relation("PublicationUpdatedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// The Auth.js tables (CAL-024)
//
// Three models the `@auth/prisma-adapter` reads and writes by name. Their shape
// is the adapter's contract, not a design of ours, and two of this repository's
// own rules bend around that on purpose.
//
// **The field names are the adapter's, not §4.2's.** `refresh_token`,
// `expires_at`, `token_type`, `id_token` and `session_state` are handed to
// `prisma.account.create({ data })` exactly as the provider's token response
// spelled them. Renaming them to camelCase would not rename what the adapter
// passes — it would make the adapter write nothing. They are a wire format that
// happens to be stored, so they keep the wire's spelling; every field this
// repository chose itself is camelCase, as everywhere else.
//
// **They carry no audit block (CAL-022), and that is the `User` exception one
// level down.** `updatedAt` is what makes a model audited, and none of the
// three has one. `VerificationToken` is written once and consumed once.
// `Account` is written at sign-in and deleted at unlink. `Session` is the only
// one that changes, and the only thing that ever changes on it is its own
// `expires`, extended by the framework on behalf of the very account the row
// belongs to — so `updatedById` could only ever repeat `userId`. Recording an
// author here would add a column and no information, exactly as it would on
// `User`. `prisma/schema.test.ts` pins the exception rather than tolerating it.
//
// They are also outside `PROJECT_OWNED_MODELS`: an account is not project data,
// it is how a project finds its owner. `UNOWNED_MODELS` names them.
//
// `Authenticator` — the adapter's fifth table — is deliberately absent. It
// serves WebAuthn, which the backlog never asks for; the adapter only touches
// it when a passkey provider is configured.
// ---------------------------------------------------------------------------

/// An identity at an external provider, attached to an account (CAL-026, CAL-027).
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The adapter looks an identity up by `provider_providerAccountId`, which is
  /// the key Prisma derives from this compound id. It is also the deduplication
  /// rule: one row per identity per provider.
  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// A signed-in session. The row *is* the session — see `SESSION_MAX_AGE_SECONDS`
/// in `@calepin/shared/auth` for why this schema stores sessions rather than
/// signing them into a token.
model Session {
  /// The primary key *is* the token the browser presents: the adapter reads a
  /// session by it and by nothing else, so a second surrogate key would be a
  /// column no query ever names.
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// An expired session is deleted, never read — Auth.js sweeps the one it
  /// finds stale, and an operator sweeps the rest. Both scan by date.
  @@index([expires])
  @@map("sessions")
}

/// A single-use token behind an email sign-in link (CAL-025).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

/// One row per email sign-in link requested, kept only to enforce the
/// five-per-hour limit (CAL-025). Not `VerificationToken` itself: that
/// table's three fields are the adapter's own contract (see the comment
/// above the Auth.js tables), and this ledger needs a fourth, `createdAt`,
/// that the adapter has no reason to ever write.
model EmailSignInRequest {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("email_sign_in_requests")
}

enum ProjectStatus {
  DRAFT
  ANALYSIS_IN_PROGRESS
  DIRECTION_TO_CHOOSE
  BIBLE_TO_VALIDATE
  OUTLINE_IN_PROGRESS
  WRITING_IN_PROGRESS
  REVISION
  COMPLETED
  PUBLISHED
  ARCHIVED

  @@map("project_status")
}

/// The four target lengths of the specification. The word ranges behind the
/// three presets — short 30-45k, standard 50-80k, long 80-110k — and the
/// chapter count derived from them belong to CAL-043; this schema stores the
/// choice, not its interpretation. CUSTOM carries its value in
/// Project.targetWordCount.
enum TargetLength {
  SHORT
  STANDARD
  LONG
  CUSTOM

  @@map("target_length")
}

/// How far the novel may travel from its source text. What each level permits
/// — a treatment per source dimension, the constraints it resolves to for the
/// analysis, direction, bible and outline missions, and the short explanation
/// the author reads — belongs to CAL-044 and lives in
/// @calepin/shared/freedom-level; this schema stores the choice, not its
/// interpretation. FREEDOM_LEVELS mirrors these members and schema.test.ts
/// pins the two against each other.
enum FreedomLevel {
  LOW
  BALANCED
  HIGH

  @@map("freedom_level")
}

model Project {
  id              String       @id @default(cuid())
  userId          String
  title           String
  language        String       @default("fr")
  targetLength    TargetLength @default(STANDARD)
  /// Set if and only if targetLength is CUSTOM, and then strictly positive.
  /// A preset stores no number: the enum already names its range, and a second
  /// column able to contradict it would become the one consumers trust.
  /// Enforced by projects_custom_target_word_count_check, which Prisma cannot
  /// express — see the add_project_custom_target_word_count migration.
  targetWordCount Int?
  targetAudience  String       @default("Grand public")
  freedomLevel    FreedomLevel @default(BALANCED)

  /// Derived state, never a field a caller sets (CAL-034). The status is a
  /// function of what the project actually holds — a source text, a validated
  /// analysis, a canonical direction, a validated bible, written and validated
  /// chapters, a visible publication — and this column caches that function the
  /// way the two counters below cache the chapters. It is maintained by
  /// @calepin/shared/repository inside the write that moved the evidence, and by
  /// nothing else: there is no path in the codebase that sets a status by hand.
  ///
  /// Outside the audit block for the same reason the counters are: the status
  /// has no author, and burning Project.version on it would make a chapter
  /// generation collide with an unrelated rename.
  status ProjectStatus @default(DRAFT)

  /// The one status the graph cannot otherwise carry (CAL-034). Archiving is a
  /// decision about the project, with no row anywhere to prove it, so it is
  /// written down the way this schema writes down every other decision of that
  /// shape — Analysis.validatedAt, Bible.validatedAt,
  /// Publication.firstPublishedAt — as a timestamp rather than as a status able
  /// to contradict one. Set by archiveProject, cleared by restoreProject, and
  /// read as evidence like everything else.
  ///
  /// No CHECK pairs it with `status`: archiving writes this column (audited, so
  /// the act keeps its author) and the derived status (raw, so the counterpart
  /// of a counter keeps no author) as two statements of one transaction, and
  /// PostgreSQL cannot defer a CHECK to the end of it.
  archivedAt DateTime?

  /// Chapters carrying at least one ChapterRevision (CAL-033). Denormalised and
  /// maintained by the write, never recomputed by the screen that shows it:
  /// every path that appends, restores or removes a chapter's text goes through
  /// `withProjectAggregates`, which rewrites both counters from the rows
  /// themselves inside the same transaction. Derived state, so it stays outside
  /// the audit block below — a counter has no author, and burning the project's
  /// `version` on it would make a chapter write collide with an unrelated edit
  /// of the project's own attributes.
  ///
  /// There is deliberately no third counter for the *planned* chapters: its
  /// write path is chapter creation, which E10 owns and which does not exist
  /// yet, and a denormalised number nothing maintains is worse than a computed
  /// one. The dashboard still joins for that one.
  ///
  /// Both counters are non-negative, enforced by
  /// projects_aggregates_non_negative_check — see the add_project_aggregates
  /// migration.
  writtenChapterCount Int @default(0)
  /// The sum of each written chapter's *latest* revision — never every revision
  /// (CAL-033). Same maintenance, same statement, so the two can never disagree.
  totalWordCount      Int @default(0)

  /// This project's own override of how many of its generations may run at
  /// once (CAL-065), when it is not the system default —
  /// `DEFAULT_PROJECT_GENERATION_CONCURRENCY_LIMIT` in
  /// @calepin/shared/generation. Same shape and same reasoning as `User`'s own
  /// field above — see projects_generation_concurrency_limit_check.
  generationConcurrencyLimit Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  user               User                @relation("ProjectOwner", fields: [userId], references: [id], onDelete: Cascade)
  sourceText         SourceText?
  analysis           Analysis?
  creativeDirections CreativeDirection[]
  bible              Bible?
  outline            Outline?
  /// The operational trace of the project (CAL-021): what was asked of a
  /// model, what it cost, and what it produced.
  generations        Generation[]
  qualityIssues      QualityIssue[]
  exports            Export[]
  publication        Publication?

  // The dashboard lists one user's projects, most recently modified first
  // (CAL-065), and filters that list by status. No index on userId alone:
  // a composite btree already serves any lookup keyed on its leading column.
  @@index([userId, updatedAt])
  @@index([userId, status])
  @@map("projects")
}

model SourceText {
  id          String   @id @default(cuid())
  projectId   String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("SourceTextUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions SourceTextVersion[]

  @@map("source_texts")
}

model SourceTextVersion {
  id            String   @id @default(cuid())
  sourceTextId  String
  versionNumber Int
  content       String
  wordCount     Int
  language      String   @default("fr")
  editedById    String
  createdAt     DateTime @default(now())

  sourceText        SourceText                @relation(fields: [sourceTextId], references: [id], onDelete: Cascade)
  editedBy          User                      @relation(fields: [editedById], references: [id], onDelete: Restrict)
  analysisRevisions AnalysisSectionRevision[]

  @@unique([sourceTextId, versionNumber])
  @@map("source_text_versions")
}

/// The seventeen sections of the narrative diagnostic, in the order the
/// specification lists them. The list is closed and pinned by schema.test.ts:
/// adding a section is a decision about the product, not a convenience.
enum AnalysisSection {
  FACTUAL_SUMMARY // résumé factuel
  PREMISE // prémisse
  MAIN_CONFLICT // conflit principal
  NARRATIVE_PROMISE // promesse du récit
  THEMES // thèmes
  CHARACTERS // personnages identifiés
  RELATIONSHIPS // relations
  POINT_OF_VIEW // point de vue
  TENSE // temps verbal
  TONE // tonalité
  SINGULAR_ELEMENTS // éléments singuliers
  AMBIGUITIES // ambiguïtés
  OPEN_QUESTIONS // questions non résolues
  ELEMENTS_TO_PRESERVE // éléments à préserver
  WEAKNESSES // fragilités
  CLICHE_RISKS // risques de clichés
  DEVELOPMENT_POTENTIAL // potentiel de développement

  @@map("analysis_section")
}

/// Fait explicite versus interprétation, per the glossary in CLAUDE.md §4.3.
/// The column is NOT NULL, which is what makes an unmarked element unstorable
/// even through a direct SQL insert — the marker is carried by the data, never
/// by the presentation.
enum AnalysisElementKind {
  FACTUAL
  INTERPRETATION

  @@map("analysis_element_kind")
}

/// Where a section revision came from. Two members, because that is the
/// distinction the version history has to show (CAL-147): a generation, or a
/// human edit. A section the author rewrote entirely is still EDITED.
///
/// Deliberately not ContentOrigin below, which it resembles. This one is a fact
/// about the *revision* — was it written by a person or produced by a model —
/// and a revision has no USER_WRITTEN state to be in: a section the author
/// filled from nothing is still a revision they edited. The two are read
/// together (resolveProvenanceState in @calepin/shared/provenance) and merging
/// them would make that reading impossible.
enum AnalysisRevisionOrigin {
  GENERATED
  EDITED

  @@map("analysis_revision_origin")
}

/// Who authored the current wording of one element — the traceability pattern
/// of CAL-073, mirrored by CONTENT_ORIGINS in @calepin/shared/provenance and
/// pinned against it by schema.test.ts.
///
/// Established for AnalysisElement and written to be reused as is by the bible,
/// the outline and the chapters: the specification's principle 4.2 asks for the
/// same distinction wherever a person edits something a model proposed, and one
/// enum answering it four times is one migration rather than four.
///
/// Three members for DirectionOrigin's reason: an element the author rewrote
/// from a proposal and one they started from nothing are worth telling apart.
/// There is no VALIDATED member, because being validated is not an authorship —
/// an element still GENERATED inside a revision a person wrote is one they read
/// and kept, which the pair of columns already says and a fourth member could
/// only contradict.
enum ContentOrigin {
  GENERATED
  EDITED
  USER_WRITTEN

  @@map("content_origin")
}

/// The narrative diagnostic of a project's source text — one per project.
/// The backlog's content line calls this NarrativeAnalysis; the identifier is
/// Analysis, fixed by the glossary in CLAUDE.md §4.3, which also names
/// AnalysisElement.kind. This model holds the validation and nothing else: the
/// content lives in the section revisions.
model Analysis {
  id            String    @id @default(cuid())
  projectId     String    @unique
  /// The validation status is this timestamp. It is set together with
  /// validatedById and never one without the other — analyses_validation_check,
  /// which Prisma cannot express, see the add_narrative_analysis migration.
  /// A status enum beside these two columns could only contradict them.
  validatedAt   DateTime?
  validatedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  updatedById   String    @default("unattributed")
  version       Int       @default(1)
  updatedBy     User      @relation("AnalysisUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict, not Prisma's SetNull default for an optional relation: nulling
  // validatedById while validatedAt stands would break
  // analyses_validation_check, so deleting the author would fail anyway — with
  // a check violation instead of the referential error that names the cause.
  validatedBy User?   @relation("AnalysisValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)

  sectionRevisions AnalysisSectionRevision[]
  annotations      AnalysisAnnotation[]

  @@map("analyses")
}

/// One version of one section. The section is the unit of regeneration
/// (CAL-077), so it is the unit of versioning: a new revision of `THEMES`
/// leaves the sixteen other sections' rows — and every annotation hanging off
/// them — untouched, which a whole-analysis snapshot could not do.
///
/// The table is append-only. The current revision of a section is the one with
/// the highest revisionNumber; there is deliberately no `isCurrent` column,
/// since a flag can point at revision 2 while revision 3 exists and no
/// constraint can forbid it.
model AnalysisSectionRevision {
  id                  String                 @id @default(cuid())
  analysisId          String
  section             AnalysisSection
  revisionNumber      Int
  origin              AnalysisRevisionOrigin
  /// The version of the source text this revision was produced against. Held
  /// per revision rather than per analysis: a section regenerated after the
  /// author edited the source text read a different version from the sections
  /// around it, and that is exactly what CAL-046 needs in order to name the
  /// sections a source-text edit made obsolete.
  sourceTextVersionId String
  /// The generation that produced this revision (CAL-021), null for an edit.
  /// ADR-001: *a successful generation appends a `Revision` linked to its
  /// `Generation`* — this column is that link, and it is what makes the port's
  /// atomic `succeed` (one transaction appending the revision and completing
  /// the generation) expressible rather than merely described.
  generationId        String?
  createdById         String
  createdAt           DateTime               @default(now())

  analysis          Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  // Restrict on both references, as SourceTextVersion.editedBy already does:
  // the record of which text a revision read, and of who asked for it, is the
  // audit trail and must not be silently orphaned. Deleting a project still
  // works — it cascades this table away before the references are checked.
  sourceTextVersion SourceTextVersion @relation(fields: [sourceTextVersionId], references: [id], onDelete: Restrict)
  createdBy         User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // SetNull, not Restrict: a generation row is an accounting record with its
  // own retention, and losing the pointer to it must never cost the author a
  // revision of their analysis.
  generation        Generation?       @relation(fields: [generationId], references: [id], onDelete: SetNull)

  elements AnalysisElement[]

  // Also the index that answers "the current revision of each section of this
  // analysis". Two concurrent regenerations of one section collide here as a
  // unique violation instead of silently losing one of them.
  @@unique([analysisId, section, revisionNumber])
  @@map("analysis_section_revisions")
}

/// One assertion about the source text. The same shape carries all seventeen
/// sections, whether the section produces a single element (résumé factuel,
/// point de vue) or a list of them (thèmes, risques de clichés). How many
/// elements a section may hold is a narrative rule and belongs to the domain's
/// output schema (CAL-070), not to a database constraint.
///
/// Immutable, like the revision that owns it, so it carries no updatedAt and no
/// author of its own: both would be copies of the revision's, able to drift
/// from it and unable to be corrected.
model AnalysisElement {
  id                String              @id @default(cuid())
  sectionRevisionId String
  /// The identity of this element across the revisions of its section — minted
  /// when it first appears, copied by every later revision that keeps it
  /// (CAL-073). The row dies with its revision; the lineage does not, which is
  /// what lets provenance be carried forward and what gives an annotation
  /// something to point at that a rewrite of the section does not destroy.
  ///
  /// Not the primary key: two revisions legitimately hold the same lineage, and
  /// the unique index below is on the pair.
  lineageId         String              @default(cuid())
  position          Int
  /// Who authored this wording. Monotone across edits — see originAfterEdit in
  /// @calepin/shared/provenance, which is the only thing allowed to compute it.
  origin            ContentOrigin
  kind              AnalysisElementKind
  /// The short heading a listed section has and a paragraph section does not —
  /// a theme's name, a character's name, the point of view, the tense.
  label             String?
  /// The element itself: one assertion, in the project's language.
  statement         String
  /// The passage of the source text that supports the element. CAL-071 owns
  /// when it is mandatory; this column is its home. It is not enforced by a
  /// CHECK here because the answer is section-dependent — a factual summary of
  /// the whole text is supported by no single passage.
  evidence          String?

  sectionRevision AnalysisSectionRevision @relation(fields: [sectionRevisionId], references: [id], onDelete: Cascade)

  @@unique([sectionRevisionId, position])
  // One lineage appears at most once per revision. It is what carryProvenance
  // guarantees and what this refuses to take on trust: a form posting the same
  // hidden lineage twice collides here instead of splitting one element's
  // history in two.
  @@unique([sectionRevisionId, lineageId])
  @@map("analysis_elements")
}

/// A free note the author attaches to one element. Mutable, unlike everything
/// above it, so it carries its own timestamps.
///
/// **It hangs off the analysis and a lineage, not off an element row** — the
/// change CAL-073 made to it. A section revision is append-only, so editing a
/// section replaces every AnalysisElement row under it; an annotation keyed on
/// one of those rows cascaded away with it, and the author's notes died at the
/// first edit of the section they were about. The lineage survives the rewrite
/// (AnalysisElement.lineageId), so the note does too — which is also what makes
/// CAL-077's *regenerating a section leaves the annotations alone* possible at
/// all.
///
/// The cost is that no foreign key checks the lineage exists. The repository
/// resolves it against the analysis before writing, and the pair is meaningless
/// outside an analysis the owner already holds a scope on.
model AnalysisAnnotation {
  id          String   @id @default(cuid())
  analysisId  String
  /// AnalysisElement.lineageId — the element this note is about, across every
  /// revision of its section.
  lineageId   String
  authorId    String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("AnalysisAnnotationUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  author   User     @relation("AnalysisAnnotationAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([analysisId, lineageId])
  @@map("analysis_annotations")
}

/// Where a creative direction came from. Three members, since that is the
/// distinction CAL-015's origin requirement draws: an AI proposal taken as is,
/// one the user edited, and one the user wrote from nothing. Mirrors
/// AnalysisRevisionOrigin's shape, not its members — a direction the user
/// rewrote from a proposal is still worth telling apart from one they started
/// blank, which GENERATED / EDITED alone cannot.
enum DirectionOrigin {
  PROPOSED // proposée
  EDITED // modifiée par l'utilisateur
  USER_WRITTEN // rédigée par l'utilisateur

  @@map("direction_origin")
}

/// One novelistic direction a project could take. Several coexist per project —
/// CAL-015 asks for at least three to be explorable side by side — and at most
/// one is canonical at a time. Flat by design: the backlog's own rationale for
/// this task is a well-defined, single-table shape, so a list-shaped attribute
/// (nouveaux enjeux, personnages à introduire, ...) is a Postgres array column
/// rather than a child table.
model CreativeDirection {
  id        String @id @default(cuid())
  projectId String

  workingTitle             String // titre de travail
  developedPremise         String // prémisse développée
  dominantGenre            String // genre dominant
  mainConflict             String // conflit principal
  protagonistArc           String // trajectoire du protagoniste
  newStakes                String[] // nouveaux enjeux
  charactersToIntroduce    String[] // personnages à introduire
  endingNature             String // nature de la fin
  mainRisks                String[] // risques principaux
  elementsKeptFromSource   String[] // éléments conservés du texte source
  elementsTransformed      String[] // éléments transformés
  novelPotentialAssessment String // évaluation du potentiel romanesque
  /// The five-axis declaration CAL-080 compares directions on — conflict
  /// nature, tension source, protagonist stake, shift trigger, resolution
  /// nature (NarrativeEngine in @calepin/direction). Stored as the mission's
  /// own validated shape rather than five columns, the way Generation.input
  /// already stores a validated contract as Json: the domain owns what is
  /// inside it, this table only owns that a direction has one.
  narrativeEngine          Json

  /// The marker the backlog asks for. At most one true row per project is
  /// enforced by creative_directions_canonical_per_project_key, a partial
  /// unique index Prisma cannot express here — see the
  /// add_creative_direction migration.
  isCanonical Boolean         @default(false)
  origin      DirectionOrigin

  /// When the author wrote this direction off (CAL-083), or null while it
  /// still stands. A timestamp beside the others rather than a status able to
  /// contradict `origin` and `isCanonical` — Project.archivedAt's shape, for
  /// its reason. Nothing is deleted: the backlog requires a discarded
  /// direction to stay consultable, and CAL-087's history is built on these
  /// rows still being here.
  discardedAt    DateTime?
  /// Why they wrote it off, in their own words, or null when they gave none —
  /// which is a complete answer and never an omission. Bounded by
  /// DIRECTION_DISCARD_REASON_CHAR_CEILING in @calepin/direction. It is the
  /// author's own prose (§9): stored, shown back to them, quoted to the model
  /// that writes the replacement, and never written to a log or a report.
  discardReason  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("CreativeDirectionUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluation DirectionEvaluation?

  @@index([projectId])
  @@map("creative_directions")
}

/// The argued critique of one direction (CAL-081), strictly separate from the
/// mission that proposes it (principle 6.2). Four lists — promises,
/// shortfalls, conventions, comparativeWeaknesses — stored as the mission's
/// own validated shape, DirectionEvaluation in @calepin/direction, the same
/// choice narrativeEngine above makes and for the same reason.
///
/// One per direction (`directionId` is unique) rather than an append-only
/// history: nothing in the backlog re-evaluates a direction in place, so a
/// second row would be a feature this schema does not yet support, not a
/// version of this one. Modeled on AnalysisSectionRevision otherwise — no
/// updatedAt, since a row nobody edits does not need to say who edited it.
model DirectionEvaluation {
  id          String @id @default(cuid())
  directionId String @unique

  promises              Json
  shortfalls            Json
  conventions           Json
  comparativeWeaknesses Json

  /// The generation that produced this critique (CAL-021), null for a
  /// fixture or an import — ADR-001's link, as AnalysisSectionRevision.
  generationId String?
  createdById  String
  createdAt    DateTime @default(now())

  direction  CreativeDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  createdBy  User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // SetNull, not Restrict: a generation row is an accounting record with its
  // own retention, and losing the pointer to it must never cost the author
  // their critique of a direction.
  generation Generation?       @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@map("direction_evaluations")
}

/// The narrative bible — the reference every later generation reads from. One
/// per project.
///
/// It holds no content of its own. The identity and style sections are their
/// own rows, and characters, places and world rules are their own tables,
/// because a generation context is composed of the few elements it needs and
/// never of the whole bible (CLAUDE.md §5.8). One row per element, and typed
/// markers to filter rows on, are what make that selection possible without
/// reading the prose first; a JSON section column would have forced reading all
/// of a section to obtain one field of it.
model Bible {
  id String @id @default(cuid())

  projectId     String    @unique
  /// The validation status is this timestamp. It is set together with
  /// validatedById and never one without the other — bibles_validation_check,
  /// which Prisma cannot express, see the add_narrative_bible migration. Same
  /// shape as Analysis: a status enum beside these two columns could only
  /// contradict them. CAL-100 owns the action and the named version it creates.
  validatedAt   DateTime?
  validatedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("BibleUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict, as Analysis.validatedBy already is: nulling validatedById while
  // validatedAt stands would break bibles_validation_check, so the delete would
  // fail anyway — with a check violation instead of the referential error that
  // names the cause.
  validatedBy User?   @relation("BibleValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)

  identity      BibleIdentity?
  style         BibleStyle?
  characters    Character[]
  relationships Relationship[]
  places        Place[]
  worldRules    WorldRule[]
  /// The chronology (CAL-017). CLAUDE.md §4.3 maps *chronologie* to `Timeline`;
  /// the timeline of a bible is this ordered set of events and not a table of
  /// its own, since a `Timeline` row would carry one foreign key and nothing
  /// else. The glossary row was amended rather than left to name a model that
  /// would exist only to be joined through.
  timeline      TimelineEvent[]
  /// The atomic facts of the canon (CAL-018).
  canonFacts    CanonFact[]
  /// The plan written against this bible (CAL-019).
  outline       Outline?

  @@map("bibles")
}

/// The identity section of the bible (CAL-088).
///
/// Its own row rather than nine more columns on Bible: it is produced by its
/// own mission, regenerated alone and locked alone, and a row that exists means
/// a section that has been produced — which is what lets every column be NOT
/// NULL instead of nine nulls each reader would have to interpret.
///
/// Two of the eleven fields CAL-088 names are deliberately absent. Longueur
/// cible and public already live on Project, chosen by the author before any
/// generation; restating them here would create the second column able to
/// contradict the first that CAL-012 recorded as a lesson. The mission reads
/// them from the project and stays consistent with them.
model BibleIdentity {
  id      String @id @default(cuid())
  bibleId String @unique

  workingTitle     String // titre de travail
  genre            String // genre
  subGenre         String // sous-genre
  tone             String // tonalité
  narrativePromise String // promesse narrative
  themes           String[] @default([]) // thèmes
  counterThemes    String[] @default([]) // contre-thèmes
  centralQuestion  String // question centrale
  /// CAL-088 calls it "type de fin"; the identifier is the one
  /// CreativeDirection already uses for the same concept one stage earlier.
  endingNature     String

  /// The lock. A timestamp is the state — there is no isLocked boolean beside
  /// it able to disagree. CAL-095 makes it bite before a generation runs.
  lockedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("BibleIdentityUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@map("bible_identities")
}

/// The style section of the bible (CAL-089), and the section a chapter-writing
/// context reads most often — which is the other reason it is a row of its own
/// rather than nine columns on a wider table.
///
/// Every field holds an operational constraint, not a decorative adjective:
/// that requirement is CAL-089's and it is about the wording the mission
/// produces, so the column type is the same free text as the rest.
model BibleStyle {
  id      String @id @default(cuid())
  bibleId String @unique

  pointOfView        String // point de vue
  focalization       String // focalisation
  tense              String // temps verbal
  languageRegister   String // niveau de langue
  descriptiveDensity String // densité descriptive
  pacing             String // rythme
  dialogueBalance    String // place du dialogue
  recurringMotifs    String[] @default([]) // motifs récurrents
  elementsToAvoid    String[] @default([]) // éléments stylistiques à éviter

  lockedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("BibleStyleUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@map("bible_styles")
}

/// How much of the cast a character is. Not a duplicate of `role`, which stays
/// the specification's free-text field naming the narrative function: this is
/// the typed marker rows are filtered on.
///
/// Without it CAL-090's own acceptance criterion — every *main* character has
/// an explicit contradiction and a need distinct from their desire — is not
/// checkable, and the context composer has no way to choose whose sheet to read
/// short of reading every sheet.
enum CharacterImportance {
  MAIN // personnage principal
  SECONDARY // personnage secondaire
  MINOR // personnage mineur

  @@map("character_importance")
}

/// One member per field of the character sheet, so that a single field can be
/// locked (CAL-095, CAL-097) without a lock naming a field no column answers
/// to. schema.test.ts pins this list against Character's own fields, so the two
/// cannot drift.
enum CharacterField {
  NAME
  AGE
  ROLE
  IMPORTANCE
  APPEARANCE
  INITIAL_SITUATION
  APPARENT_DESIRE
  DEEP_NEED
  FEAR
  CONTRADICTION
  SECRET
  PAST
  PLANNED_ARC
  SPEECH_STYLE
  HELD_KNOWLEDGE
  ELEMENTS_TO_PRESERVE

  @@map("character_field")
}

/// One character, which is also their sheet. CLAUDE.md §4.3 named the concept
/// `CharacterSheet`; the identifier is `Character`, fixed by the backlog's own
/// content line and by CAL-016's command, and the glossary row was amended
/// rather than left to carry two names for one thing.
///
/// Every field but the name is optional. The acceptance criterion is that a
/// complete sheet is *persistable*, not that an incomplete one is refused: the
/// sheet is filled progressively and CAL-097 saves as the author types. What a
/// generated sheet must contain is a narrative rule and belongs to CAL-090's
/// output schema, the same boundary AnalysisElement draws with CAL-070.
model Character {
  id      String @id @default(cuid())
  bibleId String

  name               String // nom
  /// An integer, not free text: CAL-093 must reject an impossible age
  /// arithmetically ("34 years old, and 12 thirty years ago") and CAL-017
  /// computes an age at an event. Nullable, because it can be genuinely unknown
  /// while the bible is being written; bounded below by characters_age_check
  /// and deliberately not above, since a character can be eight hundred.
  ///
  /// The age **at day 0 of the timeline**, which is the day the novel opens
  /// (CAL-017). An age is meaningless without the instant it is the age at, and
  /// naming that instant here is what lets `ageRangeAt` compute the age at any
  /// event without a second column able to contradict this one.
  age                Int?
  role               String? // rôle
  importance         CharacterImportance @default(SECONDARY)
  appearance         String? // apparence utile au récit
  initialSituation   String? // situation initiale
  apparentDesire     String? // désir apparent
  deepNeed           String? // besoin profond
  fear               String? // peur
  contradiction      String? // contradiction
  secret             String? // secret
  past               String? // passé
  plannedArc         String? // évolution prévue
  speechStyle        String? // manière de parler
  /// Connaissances détenues, as the author writes them on the sheet. The
  /// checkable form — which character knows which atomic fact — is CAL-018's
  /// CanonFact, derived from here by CAL-094; this column is its source, not a
  /// competing copy of it.
  heldKnowledge      String[]            @default([])
  /// Éléments à ne pas modifier: what the author declares must not change. It
  /// states the intent; `lockedAt` and `lockedFields` below enforce it. Both
  /// exist because the specification asks for both, and they are not
  /// interchangeable — a declaration no mechanism reads would be decoration.
  elementsToPreserve String[]            @default([])

  /// The whole sheet is locked when this is set.
  lockedAt     DateTime?
  /// The fields locked individually (CAL-097). An enum array rather than a
  /// child table: it travels with the row, so the context composer and
  /// CAL-095's guard read the lock state on a read they were making anyway,
  /// where a child table would put a join in front of the query the product
  /// runs most. A field is locked when the row is locked or the field is listed
  /// here.
  lockedFields CharacterField[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("CharacterUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  outgoingRelationships Relationship[]             @relation("RelationshipSource")
  incomingRelationships Relationship[]             @relation("RelationshipTarget")
  /// Every event of the chronology this character is present at (CAL-017).
  timelineAppearances   TimelineEventParticipant[]
  /// This character's stance on each canonical fact (CAL-018) — the checkable
  /// form of heldKnowledge above, derived from it by CAL-094.
  factBeliefs           CanonFactBelief[]
  /// The canonical facts this character is a subject of (CAL-018).
  factSubjects          CanonFactSubject[]
  /// The chapters this character is the focal one of (CAL-019).
  chapterOutlinesFocal  ChapterOutline[]
  /// The planned chapters this character is present in (CAL-019).
  chapterAppearances    ChapterOutlineCharacter[]

  // The target of Relationship's two composite foreign keys. It is what makes a
  // relationship between two bibles unstorable rather than merely unlikely.
  @@unique([bibleId, id])
  // A model may name a character; business code resolves the primary key
  // (CLAUDE.md §6). That resolution needs the name to be unique inside a bible,
  // so it is a constraint rather than a hope — and it also means a rerun of the
  // character mission cannot silently produce a second sheet for the same name.
  @@unique([bibleId, name])
  // "The main characters of this bible", without reading a single sheet.
  @@index([bibleId, importance])
  @@map("characters")
}

/// The nature of a tie. The specification names no list, so this one is
/// CAL-016's design: broad enough that a novel's ties land in it, with OTHER
/// and the free-text label carrying what it does not name. Adding a member
/// later is a one-line migration; loosening the column to free text would not
/// be.
enum RelationshipType {
  FAMILY // famille
  ROMANTIC // amour
  FRIENDSHIP // amitié
  PROFESSIONAL // travail
  MENTORSHIP // mentorat
  ALLIANCE // alliance
  RIVALRY // rivalité
  HOSTILITY // hostilité
  OTHER // autre, précisé par label

  @@map("relationship_type")
}

/// A directed edge between two characters of the same bible: one row per
/// direction, and the reverse direction is a second row that may say something
/// else. That is what makes "A knows about B what B ignores" representable
/// (CAL-091).
///
/// The mirror row is never created automatically, and that is a decision rather
/// than an omission: CAL-099 has to *detect a missing symmetric relation*, and
/// a schema that writes the mirror itself can never produce one to detect.
///
/// bibleId is not a copy able to drift from the characters' own. It is part of
/// both foreign keys, which reference Character(bibleId, id), so a row whose
/// bible disagrees with its characters — or whose two characters come from
/// different bibles — is rejected by PostgreSQL. It is carried here so that the
/// relationship graph of a bible is one query rather than a join through
/// characters.
model Relationship {
  id      String @id @default(cuid())
  bibleId String

  fromCharacterId String
  toCharacterId   String
  type            RelationshipType
  /// The tie in the project's language, written from the source character's
  /// side: "père de", "ancienne associée de".
  label           String
  /// What holds from the source character's side only — what A believes, knows
  /// or feels about B. The asymmetry is written here; its checkable form is
  /// CAL-018's per-character knowledge of an atomic fact.
  description     String?

  lockedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("RelationshipUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  bible         Bible     @relation(fields: [bibleId], references: [id], onDelete: Cascade)
  fromCharacter Character @relation("RelationshipSource", fields: [bibleId, fromCharacterId], references: [bibleId, id], onDelete: Cascade)
  toCharacter   Character @relation("RelationshipTarget", fields: [bibleId, toCharacterId], references: [bibleId, id], onDelete: Cascade)

  // Two characters may be tied in several ways at once — family and rivalry —
  // so the type is part of the key. It also turns a rerun of the relationship
  // mission into a unique violation instead of a duplicated edge.
  @@unique([fromCharacterId, toCharacterId, type])
  // The relations pointing *at* a character. Its outgoing ones are already
  // served by the unique index above, whose leading column they are.
  @@index([toCharacterId])
  // The whole graph of a bible, in one query.
  @@index([bibleId])
  @@map("relationships")
}

/// A place of the novel. Named uniquely inside its bible for the same reason a
/// character is: a chapter outline will reference a place the model named, and
/// business code resolves that name to a primary key (CLAUDE.md §6, CAL-102).
model Place {
  id      String @id @default(cuid())
  bibleId String

  name        String // nom
  description String?

  lockedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("PlaceUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  /// The canonical facts this place is a subject of (CAL-018).
  factSubjects    CanonFactSubject[]
  /// The planned chapters set in this place (CAL-019).
  chapterOutlines ChapterOutline[]

  // The target of CanonFactSubject's composite key, the role Character and
  // TimelineEvent already play for theirs: it is what keeps a fact's subjects
  // inside the fact's own bible.
  @@unique([bibleId, id])
  @@unique([bibleId, name])
  @@map("places")
}

/// A rule of the novel's world.
///
/// `limits` is required of anything marked supernatural —
/// world_rules_supernatural_limits_check, hand-written in the migration —
/// because CAL-092's imperative is that no out-of-norm capability may be
/// declared without explicit boundaries. That requirement is not decorative: a
/// power with no stated limit, cost or failure condition is exactly what makes
/// a resolution by convenience undetectable later (CAL-159).
model WorldRule {
  id      String @id @default(cuid())
  bibleId String

  /// A short handle, so a locked rule can be cited by name when it blocks a
  /// generation (CAL-095, CAL-115).
  name              String
  statement         String
  /// Covers any out-of-norm capability, not only the supernatural in the strict
  /// sense — CAL-092's own wording is "élément surnaturel ou capacité hors
  /// norme".
  isSupernatural    Boolean  @default(false)
  limits            String[] @default([]) // limites — non-empty whenever isSupernatural
  costs             String[] @default([]) // coûts
  failureConditions String[] @default([]) // conditions d'échec

  lockedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("WorldRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@unique([bibleId, name])
  @@map("world_rules")
}

/// The three kinds of moment a chronology holds, in the specification's own
/// terms.
///
/// They are narrative categories, not statements about the day axis. A
/// BACKSTORY event normally sits before day 0 and a PLANNED one after the last
/// narrated chapter, but the two are deliberately not tied together by a
/// constraint: an event whose category and whose date disagree is one of the
/// inconsistencies CAL-093 exists to report, and a CHECK would make it
/// unstorable instead of visible.
enum TimelineEventCategory {
  BACKSTORY // antérieur au roman
  NARRATED // raconté
  PLANNED // prévu

  @@map("timeline_event_category")
}

/// How finely a date or a duration is known. "Spring 1892" is not a day, and
/// "three years later" is not 1095 days: an age computed from either carries an
/// uncertainty, and a detector that ignores it reports a contradiction on data
/// that never contradicted itself.
///
/// This schema stores the choice, not its interpretation — the tolerance in
/// days behind each member is a narrative rule and belongs to the domain, the
/// same boundary TargetLength already draws.
enum TimelinePrecision {
  DAY
  MONTH
  SEASON
  YEAR
  DECADE

  @@map("timeline_precision")
}

/// One moment of the novel's chronology (CAL-017).
///
/// **The axis is an integer number of days from the day the novel opens**, day
/// 0, negative before it. Not a DateTime: a fictional calendar does not map to
/// the Gregorian one, "spring 1892" is not a timestamp, and an age is computed
/// by subtracting two positions — which a timestamp column would allow but a
/// free-text date would not. How a day is written in the novel's own terms is
/// `dateLabel`'s job, beside the number, never instead of it.
///
/// An event is placed in one of two ways, and may carry both:
///
/// - **absolutely** — `absoluteDay` with the precision it is known to;
/// - **relatively** — `precedingEventId`, alone for pure ordering (the case the
///   backlog names: events with no date but a known order), or with
///   `daysAfterPreceding` to resolve to a day whenever the anchor resolves.
///
/// Carrying both is the point rather than an oversight. When the stated date
/// and the chain disagree, that disagreement *is* the inconsistent duration
/// CAL-093 has to detect; a schema that made the two mutually exclusive would
/// delete the evidence before the detector could read it. The agreement is not
/// a CHECK because it spans rows — the anchor's own day may itself be relative
/// — and PostgreSQL cannot express that.
///
/// There is deliberately no manual `position` column. A third ordering able to
/// contradict the other two would become the one consumers trust, which is
/// CAL-012's recorded lesson; the order is reconstructed from the data by
/// `resolveTimeline` in @calepin/bible.
model TimelineEvent {
  id      String @id @default(cuid())
  bibleId String

  /// A short handle, unique inside the bible: a model may name an event and
  /// business code resolves the primary key (CLAUDE.md §6), the same rule
  /// Character, Place and WorldRule already follow.
  name     String
  summary  String?
  category TimelineEventCategory

  /// Days from the day the novel opens. Negative before it.
  absoluteDay   Int?
  /// Set if and only if absoluteDay is — timeline_events_absolute_date_check.
  /// A date whose precision is unknown would be read as day-precise by every
  /// consumer, which is the false-positive machine this enum exists to avoid.
  datePrecision TimelinePrecision?
  /// The date as the novel writes it, in the project's language. Free of the
  /// number beside it: an author may know the words before the position.
  dateLabel     String?

  /// The event this one is placed after. Composite foreign key on
  /// (bibleId, id), like Relationship's two ends, so an event of another
  /// bible cannot be the anchor.
  precedingEventId   String?
  /// The duration since the preceding event, in days, and never negative —
  /// "depuis" means the anchor comes first, so a chain always runs one way and
  /// resolution terminates. Null with an anchor set means pure ordering.
  daysAfterPreceding Int?
  /// Set if and only if daysAfterPreceding is —
  /// timeline_events_relative_date_check.
  durationPrecision  TimelinePrecision?

  /// The lock, same convention as every other bible element (CAL-095).
  lockedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("TimelineEventUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  bible           Bible           @relation(fields: [bibleId], references: [id], onDelete: Cascade)
  // NoAction, and above all not Prisma's SetNull default for an optional
  // relation. PostgreSQL nulls *every* column of a composite key, `bibleId`
  // included, so SET NULL here does not un-place the follower — it fails on
  // `bibleId`'s NOT NULL with an error that names neither the event nor the
  // cause. Probed, not assumed; the add_timeline migration records the trace.
  //
  // Deleting an anchored event is therefore refused, which is the intent: it
  // would silently un-place everything hanging off it. Deleting the bible or
  // the project still cascades — the referencing rows go in the same statement,
  // before the check runs.
  precedingEvent  TimelineEvent?  @relation("TimelineEventChain", fields: [bibleId, precedingEventId], references: [bibleId, id], onDelete: NoAction, onUpdate: NoAction)
  followingEvents TimelineEvent[] @relation("TimelineEventChain")

  participants TimelineEventParticipant[]

  /// The canonical facts this event ends (CAL-018, UNTIL_EVENT).
  invalidatedFacts CanonFact[]

  // The target of this model's own chain key and of the participants' event
  // key. It is what keeps a chronology inside one bible.
  @@unique([bibleId, id])
  @@unique([bibleId, name])
  // The chronology of a bible, read in order, which is the query this table
  // exists for.
  @@index([bibleId, absoluteDay])
  // Resolving the chain: the events anchored to a given one. PostgreSQL does
  // not index a foreign key on its own.
  @@index([bibleId, precedingEventId])
  @@map("timeline_events")
}

/// A character present at an event — "personnages présents", one row per
/// presence.
///
/// It stores no computed age. The age at an event follows from `Character.age`
/// (the age at day 0) and the event's day, so a column here would be the copy
/// able to drift that CAL-012 recorded as a lesson.
///
/// `declaredAge` is a different thing, and it is the reason this table has a
/// column at all: the age the text *asserts* for this character at this event.
/// It is an independent statement by the author, not a cache of the
/// computation, and comparing the two is exactly how CAL-093 detects an
/// incompatible age.
///
/// bibleId is not a copy able to drift either — it is part of both foreign
/// keys, so a participation tying a character to an event of another bible is
/// rejected by PostgreSQL. No separate foreign key to bibles is needed: both
/// keys already reference rows that carry it.
model TimelineEventParticipant {
  id      String @id @default(cuid())
  bibleId String

  eventId     String
  characterId String
  /// Bounded below by timeline_event_participants_declared_age_check, and
  /// deliberately not above, as characters_age_check already is.
  declaredAge Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("TimelineEventParticipantUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  event     TimelineEvent @relation(fields: [bibleId, eventId], references: [bibleId, id], onDelete: Cascade)
  character Character     @relation(fields: [bibleId, characterId], references: [bibleId, id], onDelete: Cascade)

  // One presence per character per event. A rerun of the mission that fills the
  // timeline collides here instead of doubling a character's presence.
  @@unique([eventId, characterId])
  // Every event a character is present at, which is the read CAL-093 makes to
  // check one character's ages across the whole chronology.
  @@index([characterId])
  @@map("timeline_event_participants")
}

/// The three temporal shapes of a canonical fact, in the specification's own
/// terms: always true, true during a period, false after a given event. Closed
/// and pinned by schema.test.ts — a fourth shape (a fact true *since* an
/// event, say) is a decision about the product, one member and one column
/// away, owned by the task that needs it.
enum CanonFactValidity {
  PERMANENT // permanent
  DURING_PERIOD // vrai pendant une période
  UNTIL_EVENT // faux après un événement donné

  @@map("canon_fact_validity")
}

/// Where a fact came from — the four provenances the product actually has.
/// Finer provenance (which chapter asserted it) belongs to the epic that
/// writes chapters; a column for a table that does not exist is not added.
enum CanonFactSource {
  SOURCE_TEXT // extrait du texte source
  BIBLE // dérivé d'une fiche de la bible (CAL-094)
  CHAPTER // extrait d'un chapitre rédigé (E13)
  USER // saisi par l'auteur

  @@map("canon_fact_source")
}

/// The lifecycle of a fact. PROPOSED rows await the author; only CONFIRMED
/// rows are canon — what the context composer sends and the coherence engine
/// defends. REJECTED rows are kept, not deleted, so re-extraction can
/// deduplicate against what the author already refused instead of re-proposing
/// it forever. Status is not truth: the canon holds confirmed facts whose
/// isTrue is false.
enum CanonFactStatus {
  PROPOSED // proposé
  CONFIRMED // confirmé — entré dans le canon
  REJECTED // rejeté — conservé pour la déduplication

  @@map("canon_fact_status")
}

/// A character's stance on a fact's statement, deliberately independent of the
/// fact's own truth value. There is no KNOWS member: knowing is believing what
/// the world holds, so it is derived by comparing the two dimensions
/// (beliefMatchesWorld in @calepin/bible), and a stored KNOWS would be a
/// second column able to contradict isTrue — CAL-012's lesson applied to
/// epistemics. The same derivation reads a belief the world contradicts as
/// dramatic irony, a query instead of a feature.
enum CanonFactBeliefState {
  BELIEVES_TRUE // croit l'énoncé vrai
  BELIEVES_FALSE // croit l'énoncé faux
  UNAWARE // ignore la question

  @@map("canon_fact_belief_state")
}

/// One atomic canonical fact (CAL-018) — the unit the coherence engine checks
/// (CAL-099, E13) and the context composer selects (§5.8). Three independent
/// dimensions, one per group of columns: the truth value in the world
/// (`isTrue`), the temporal validity (`validity` and its bounds), and
/// per-character knowledge (`CanonFactBelief` rows). The specification's three
/// examples each isolate one dimension, and none is expressible through
/// another.
///
/// The statement is written in affirmative form and the polarity lives in
/// `isTrue`: the specification's negative example is stored as the affirmative
/// statement marked false, never as a negated sentence. Polarity inside prose
/// is invisible to a query; in a column it is what lets the detector surface
/// two facts with comparable statements and opposite truth values, and what
/// lets a planted rumour enter the canon as data without entering it as truth.
/// The affirmative form is a convention for the missions and the UI — no CHECK
/// can parse French negation, and one that tried would reject valid sentences.
///
/// There is no `name` handle, unlike WorldRule's: the statement is already the
/// atomic, citable form, and a short label beside it would be a copy able to
/// drift. Nor a unique on the statement — a semantic duplicate reworded is
/// invisible to a btree; deduplication belongs to the extraction mission,
/// which is also why REJECTED rows survive.
model CanonFact {
  id      String @id @default(cuid())
  bibleId String

  /// The assertion, in the project's language, in affirmative form.
  statement String
  /// The truth value in the world of the novel — not in any character's mind,
  /// which is the belief rows' dimension. No default: a defaulted truth value
  /// is a decision the author never made, stored as if they had.
  isTrue    Boolean

  /// The specification's three temporal cases. Which of the columns below may
  /// be set follows from the mode — canon_facts_validity_check, which Prisma
  /// cannot express; see the add_canon_facts migration.
  validity CanonFactValidity @default(PERMANENT)

  /// The period, on the timeline's own axis: days from the day the novel
  /// opens, negative before it (CAL-017). Each bound is paired with the
  /// precision it is known to (canon_facts_valid_from_precision_check and its
  /// until twin) and carries the author's own wording beside the number, never
  /// instead of it — a bound may be words alone, exactly as a timeline event
  /// may, so a dated fact is representable before day 0 is anchored to any
  /// calendar. A bound restating a date the timeline also carries is
  /// declaredAge's pattern, not CAL-012's drifting copy: an independent
  /// assertion by the canon, which the detector compares against the
  /// chronology (CAL-093, CAL-099). Both ends inclusive; when both are
  /// numbered, from never exceeds until (canon_facts_period_order_check).
  validFromDay        Int?
  validFromPrecision  TimelinePrecision?
  validFromLabel      String?
  validUntilDay       Int?
  validUntilPrecision TimelinePrecision?
  validUntilLabel     String?

  /// UNTIL_EVENT's boundary: the fact holds strictly before this event's day
  /// and no longer on it — the event is the moment the world changes, and the
  /// day it happens already belongs to the changed world.
  invalidatedByEventId String?

  source CanonFactSource
  status CanonFactStatus @default(PROPOSED)

  /// The lock, same convention as every other bible element (CAL-095).
  lockedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("CanonFactUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  bible              Bible          @relation(fields: [bibleId], references: [id], onDelete: Cascade)
  // NoAction, never Prisma's SetNull default for an optional relation:
  // PostgreSQL nulls every column of a composite key, bibleId included, where
  // it hits a NOT NULL with an error naming neither the fact nor the cause —
  // the add_timeline migration records the probe. Deleting an event a fact
  // depends on is therefore refused, which is the intent: it would silently
  // strip the boundary that gives the fact its meaning. Deleting the bible or
  // the project still cascades — the facts go in the same statement, before
  // the check runs.
  invalidatedByEvent TimelineEvent? @relation(fields: [bibleId, invalidatedByEventId], references: [bibleId, id], onDelete: NoAction, onUpdate: NoAction)

  beliefs         CanonFactBelief[]
  subjects        CanonFactSubject[]
  /// The planned chapters concerned by this fact (CAL-019).
  chapterOutlines ChapterOutlineFact[]

  // The target of the belief and subject composite keys, the role Character
  // and TimelineEvent already play: it is what keeps a fact's rows inside the
  // fact's own bible.
  @@unique([bibleId, id])
  // The canon of a bible — the read the composer and the checker make most:
  // confirmed facts, without reading a statement.
  @@index([bibleId, status])
  // The facts an event ends. PostgreSQL does not index a foreign key on its
  // own, and the NO ACTION check on event deletion walks this path.
  @@index([bibleId, invalidatedByEventId])
  @@map("canon_facts")
}

/// One character's stance on one fact — the specification's unaware example as
/// a row, and the checkable form of the sheet's free-text heldKnowledge,
/// derived from it by CAL-094.
///
/// No row means the author has not decided, which is weaker than UNAWARE: an
/// explicit UNAWARE is canon a generation must respect — a scene through this
/// character's eyes must not act on the fact — while an absent row constrains
/// nothing. The two must not be conflated, and the composer reads the
/// distinction from row presence.
///
/// bibleId is part of both foreign keys, as TimelineEventParticipant's is, so
/// a belief tying a character to a fact of another bible is unstorable.
model CanonFactBelief {
  id      String @id @default(cuid())
  bibleId String

  factId      String
  characterId String
  state       CanonFactBeliefState

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("CanonFactBeliefUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  fact      CanonFact @relation(fields: [bibleId, factId], references: [bibleId, id], onDelete: Cascade)
  character Character @relation(fields: [bibleId, characterId], references: [bibleId, id], onDelete: Cascade)

  // One stance per character per fact. A rerun of the mission that derives
  // beliefs collides here instead of doubling a stance.
  @@unique([factId, characterId])
  // Everything one character believes — the read the composer makes for a
  // point of view.
  @@index([characterId])
  @@map("canon_fact_beliefs")
}

/// An entity a fact concerns — a character or a place, exactly one per row
/// (canon_fact_subjects_exactly_one_check). CLAUDE.md §5.8 composes a context
/// from "the canon facts actually concerned", and this is the marker that
/// selects those facts without reading their prose: the facts about the
/// scene's characters and place, in one query. Subjects carry aboutness,
/// belief rows carry epistemic state — the specification's negative example
/// concerns a place and needs no belief row; its unaware example concerns one
/// character while the belief row names another.
///
/// Duplicate subjects are refused by two partial unique indexes, hand-written
/// in the add_canon_facts migration since Prisma cannot express a partial
/// index — the shape creative_directions' canonical index already uses. A
/// timeline event is deliberately not a subject kind: the invalidating
/// reference on the fact is the only event linkage the specification's cases
/// require.
model CanonFactSubject {
  id      String @id @default(cuid())
  bibleId String

  factId      String
  characterId String?
  placeId     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("CanonFactSubjectUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  fact      CanonFact  @relation(fields: [bibleId, factId], references: [bibleId, id], onDelete: Cascade)
  character Character? @relation(fields: [bibleId, characterId], references: [bibleId, id], onDelete: Cascade)
  place     Place?     @relation(fields: [bibleId, placeId], references: [bibleId, id], onDelete: Cascade)

  // The facts a character is concerned by, and a place's twin — the selection
  // §5.8 runs. The duplicate guard is the pair of partial unique indexes in
  // the migration, whose leading factId column serves the subjects-of-a-fact
  // read.
  @@index([characterId])
  @@index([placeId])
  @@map("canon_fact_subjects")
}

/// The plan of the novel (CAL-019) — one per project.
///
/// It holds no content of its own: the parts are its rows and the chapters are
/// theirs. What it does hold is the frame the plan is written against — the
/// project it belongs to, and the bible its chapters cite. A plan cannot exist
/// before a bible does (CAL-101 reads a validated one), and `bibleId` sits here
/// rather than being reached through the project because it is the leading
/// column of every composite foreign key below: it is what makes a chapter
/// focalised on another project's character unstorable rather than unlikely.
model Outline {
  id String @id @default(cuid())

  projectId String @unique
  bibleId   String @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("OutlineUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bible   Bible   @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  parts    Part[]
  chapters Chapter[]
  /// The narrative threads of this plan (CAL-020).
  threads  Thread[]

  // The target of Chapter's outline key. `bibleId` is already unique on its
  // own, so this adds nothing to the data — PostgreSQL simply requires a unique
  // constraint on exactly the referenced columns.
  @@unique([bibleId, id])
  @@map("outlines")
}

/// One part of the novel (CAL-101): a run of consecutive chapters carrying a
/// dramatic arc of its own.
///
/// Its place in the plan is `orderKey` and never a number, for the reason
/// Chapter states in full. Every attribute but the title is optional: CAL-101's
/// criterion is that a part *has* an identifiable tipping point, and a part the
/// author added by hand starts empty — CAL-110's audit exists to report the
/// gap, which a NOT NULL would make unstorable instead of visible.
///
/// The narrative threads a part concerns are CAL-020's; `@@unique([outlineId,
/// id])` is already the key its links will hang off.
model Part {
  id        String @id @default(cuid())
  outlineId String

  /// The fractional index placing this part among its siblings. Shape enforced
  /// by parts_order_key_check.
  orderKey String

  title             String
  dramaticObjective String? // objectif dramatique
  initialState      String? // état initial
  tippingPoint      String? // basculement
  finalState        String? // état final

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("PartUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  outline  Outline   @relation(fields: [outlineId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  /// The summaries of what this part's chapters turned out to contain
  /// (CAL-055) — append-only, and retrospective where the four attributes
  /// above are the plan.
  summaryRevisions PartSummaryRevision[]

  // The target of Chapter's part key.
  @@unique([outlineId, id])
  // A model may name a part and business code resolves the primary key
  // (CLAUDE.md §6), which needs the title to be unique inside the plan — the
  // rule Character, Place, WorldRule and TimelineEvent already follow. A rerun
  // of CAL-101's mission then collides here instead of doubling a part.
  @@unique([outlineId, title])
  // Two parts cannot hold the same place, and this is the index the plan is
  // read in order by.
  @@unique([outlineId, orderKey])
  @@map("parts")
}

/// The seven statuses of a chapter, in the specification's own order (CAL-124).
/// The list is closed and pinned by schema.test.ts.
///
/// LOCKED is a status here rather than the `lockedAt` timestamp every bible
/// element carries, because the specification made the lock one of the seven
/// states of the chapter's life. The *plan* of a chapter is a different thing
/// and is locked the usual way — ChapterOutline.lockedAt.
enum ChapterStatus {
  PLANNED // planifié
  TO_WRITE // à rédiger
  GENERATING // génération en cours
  FIRST_DRAFT // premier jet
  TO_REVISE // à corriger
  VALIDATED // validé
  LOCKED // verrouillé

  @@map("chapter_status")
}

/// One chapter — the spine of both the plan and the manuscript (CAL-019).
///
/// Everything downstream cites a chapter: a thread opens and closes at one
/// (CAL-020), a fact is extracted from one (E12), a finding names one (E13), a
/// comment hangs off one (CAL-124). One entity to reference is what "breaks no
/// reference" means in practice, so the ordering, the part membership and the
/// status live here and the plan hangs off this row rather than the reverse.
///
/// **There is deliberately no number and no position column.** The number a
/// reader sees is derived from the order by `resolveOutline` in
/// @calepin/outline, and the order is `orderKey`, a fractional index string. A
/// stored number is rewritten on every insertion and every move — forty-seven
/// rows to insert at position 3 of fifty — and, worse, it becomes an identity:
/// anything citing "chapter 7" points at a different chapter after one move.
/// Minting one key between two neighbours rewrites nothing, which is precisely
/// what keeps the ordering stable under insertion, move, merge and split
/// without breaking a reference. Same reasoning as TimelineEvent's absent
/// `position`, and CAL-012's recorded lesson: a second ordering able to
/// contradict the first becomes the one consumers trust.
///
/// `orderKey` is scoped to the part, so the reading order is
/// `(part.orderKey, chapter.orderKey)` and the chapters of a part are
/// necessarily contiguous — a property a plan-wide key could not give.
model Chapter {
  id        String @id @default(cuid())
  outlineId String
  bibleId   String
  partId    String

  /// The fractional index placing this chapter among its part's siblings.
  /// Shape enforced by chapters_order_key_check: the alphabet is 0-9a-z and a
  /// key never ends in 0, because a trailing zero makes two keys the same
  /// fraction and the midpoint between them stop existing.
  orderKey String
  status   ChapterStatus @default(PLANNED)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("ChapterUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  outline Outline @relation(fields: [bibleId, outlineId], references: [bibleId, id], onDelete: Cascade)
  // NoAction, never Cascade: deleting a part that still holds chapters would
  // take the manuscript with it without saying so. The plan screen moves the
  // chapters out first. Deleting the outline or the project still works — the
  // chapters go in the same statement, before the check runs — and that claim
  // is probed by the integration suite rather than asserted here, per the
  // CAL-017 lesson.
  part    Part    @relation(fields: [outlineId, partId], references: [outlineId, id], onDelete: NoAction, onUpdate: NoAction)

  chapterOutline       ChapterOutline?
  revisions            ChapterRevision[]
  /// The threads this chapter opens (CAL-020).
  threadOpenings       Thread[]              @relation("ThreadOpening")
  /// The threads this chapter closes.
  threadClosings       Thread[]              @relation("ThreadClosing")
  /// The threads this chapter carries forward.
  threadContinuations  ThreadContinuation[]
  /// The passages of this chapter a quality issue points at (CAL-021).
  qualityIssuePassages QualityIssuePassage[]

  // The target of ChapterOutline's chapter key, and of everything E12 and E13
  // will tie to a chapter inside one bible.
  @@unique([bibleId, id])
  // Two chapters cannot hold the same place in a part, and this is the index a
  // part is read in order by.
  @@unique([partId, orderKey])
  // The whole plan in one query. Neither key above leads with outlineId, and
  // PostgreSQL does not index a foreign key on its own.
  @@index([outlineId])
  @@map("chapters")
}

/// The plan of one chapter (CAL-102) — the sixteen attributes the
/// specification names, minus the number, which is derived, and minus the
/// narrative threads, which are CAL-020's own table.
///
/// CLAUDE.md §4.3 maps *plan de chapitre* to `ChapterOutline` while the
/// backlog's content line calls it `ChapterPlan`. The glossary identifier is
/// kept rather than amended, unlike CAL-016's and CAL-017's: *plan* is already
/// `Outline`, and `ChapterPlan` beside it would be two English words for one
/// French concept inside one model family.
///
/// Its own row rather than fifteen more columns on Chapter: it is produced by
/// its own mission, regenerated alone (CAL-111) and locked alone (CAL-107),
/// and the context composer reads it without dragging status and prose along
/// (§5.8). Every attribute is optional — the criterion is that a complete plan
/// is *persistable*, and CAL-110's audit exists to report a chapter with no
/// dramatic function, which a NOT NULL would make unstorable instead of
/// visible, the trap TimelineEventCategory already records.
model ChapterOutline {
  id        String @id @default(cuid())
  bibleId   String
  chapterId String @unique

  workingTitle    String? // titre provisoire
  /// Longueur cible. Strictly positive when set —
  /// chapter_outlines_target_word_count_check. CAL-103 sums these against the
  /// novel's own target.
  targetWordCount Int?

  focalCharacterId String? // personnage focal
  placeId          String? // lieu

  /// Période — the chapter's moment on the chronology's axis: days from the day
  /// the novel opens, negative before it (CAL-017). Both bounds inclusive, one
  /// precision for the span since a chapter is stated at a single granularity,
  /// and the author's own wording beside the numbers rather than instead of
  /// them, so a chapter may be placed by words alone exactly as a timeline
  /// event may. Numbered rather than free text because E13 has to compare a
  /// chapter's moment against a fact's validity window, and two prose strings
  /// do not compare. Paired by chapter_outlines_period_precision_check and
  /// ordered by chapter_outlines_period_order_check.
  periodStartDay  Int?
  periodEndDay    Int?
  periodPrecision TimelinePrecision?
  periodLabel     String?

  dramaticFunction String? // fonction dramatique
  immediateGoal    String? // objectif immédiat
  obstacle         String? // obstacle
  decision         String? // décision
  revelation       String? // révélation éventuelle
  consequence      String? // conséquence
  detailedSummary  String? // résumé détaillé

  /// The lock on the *plan* of the chapter (CAL-107), the timestamp convention
  /// every bible element uses; CAL-111 reads it to leave a locked neighbour
  /// alone. The lock on the written chapter is Chapter.status = LOCKED.
  lockedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("ChapterOutlineUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  chapter        Chapter    @relation(fields: [bibleId, chapterId], references: [bibleId, id], onDelete: Cascade)
  // SET NULL **on one column only** — `ON DELETE SET NULL ("focalCharacterId")`,
  // written by hand in the migration because Prisma cannot express the column
  // list. Deleting a character un-focalises the chapters they focalised, and
  // deleting a place empties the chapters set in it; the plan keeps its fifteen
  // other attributes and CAL-108 reports the hole.
  //
  // Neither of the two actions the schema already uses works here, and the
  // probe is what said so rather than the reasoning:
  //
  //   - plain SET NULL nulls *every* column of the composite key, bibleId
  //     included, where it hits a NOT NULL — the add_timeline trap;
  //   - NO ACTION, which is add_timeline's answer, makes deleting the **project**
  //     fail. There the referencing rows and the referenced ones sat in the same
  //     cascade subtree and went in the same statement; here they are in two —
  //     characters hang off the bible, chapter outlines off the outline — and
  //     the check on the character delete fires before the other branch has run.
  //
  // The column list, PostgreSQL 15 and later, is what keeps the same-bible
  // guarantee and the cascade at the same time.
  focalCharacter Character? @relation(fields: [bibleId, focalCharacterId], references: [bibleId, id], onDelete: SetNull, onUpdate: NoAction)
  place          Place?     @relation(fields: [bibleId, placeId], references: [bibleId, id], onDelete: SetNull, onUpdate: NoAction)

  characters ChapterOutlineCharacter[]
  facts      ChapterOutlineFact[]

  // The target of the two link tables' plan key.
  @@unique([bibleId, id])
  // One plan per chapter is `chapterId @unique` above, which is also the key
  // the plan of a chapter is read by. This composite restates it because
  // PostgreSQL — and Prisma before it — requires a unique constraint on exactly
  // the columns a foreign key references.
  @@unique([bibleId, chapterId])
  // The chapters a character focalises, and the ones set in a place. PostgreSQL
  // does not index a foreign key on its own, and the NO ACTION check on
  // deletion walks both paths.
  @@index([bibleId, focalCharacterId])
  @@index([bibleId, placeId])
  @@map("chapter_outlines")
}

/// A character the chapter plans to bring on — "personnages présents", one row
/// per presence. The focal character is a column of the plan and not a flag
/// here: a chapter has one point of view, and it is read without walking a
/// collection.
///
/// An immutable link: it is added or removed, never edited, so it carries no
/// updatedAt that could only ever equal its createdAt.
model ChapterOutlineCharacter {
  id      String @id @default(cuid())
  bibleId String

  chapterOutlineId String
  characterId      String

  createdAt DateTime @default(now())

  chapterOutline ChapterOutline @relation(fields: [bibleId, chapterOutlineId], references: [bibleId, id], onDelete: Cascade)
  character      Character      @relation(fields: [bibleId, characterId], references: [bibleId, id], onDelete: Cascade)

  // One presence per character per chapter. A rerun of CAL-102's mission
  // collides here instead of doubling a presence.
  @@unique([chapterOutlineId, characterId])
  // Every chapter a character appears in — the read CAL-108 makes to find what
  // a move affects.
  @@index([characterId])
  @@map("chapter_outline_characters")
}

/// A canonical fact the chapter is concerned by — "faits canoniques concernés".
/// It is the selection §5.8 composes a writing context from: the facts this
/// chapter actually needs, chosen without reading a statement.
model ChapterOutlineFact {
  id      String @id @default(cuid())
  bibleId String

  chapterOutlineId String
  factId           String

  createdAt DateTime @default(now())

  chapterOutline ChapterOutline @relation(fields: [bibleId, chapterOutlineId], references: [bibleId, id], onDelete: Cascade)
  fact           CanonFact      @relation(fields: [bibleId, factId], references: [bibleId, id], onDelete: Cascade)

  @@unique([chapterOutlineId, factId])
  // Every chapter a fact is used in — what CAL-108 reads to name the chapters
  // a changed fact puts at risk.
  @@index([factId])
  @@map("chapter_outline_facts")
}

/// Where a revision of a chapter came from. Two members, the same distinction
/// AnalysisRevisionOrigin draws and the only one CAL-147's history has to show:
/// a generation, or a human edit. A chapter the author rewrote entirely is
/// still EDITED, and a restoration (CAL-149) appends a row like any other.
enum ChapterRevisionOrigin {
  GENERATED
  EDITED

  @@map("chapter_revision_origin")
}

/// One version of a chapter's text (CAL-122) — append-only.
///
/// The table *is* the non-destructive versioning the specification asks for: a
/// generation appends a row, an edit appends a row, and a restoration appends a
/// row carrying the older text (CAL-149). Nothing is ever overwritten, so three
/// regenerations leave four versions accessible and restorable.
///
/// The current revision of a chapter is the one with the highest
/// revisionNumber. There is deliberately no isCurrent column, for the reason
/// AnalysisSectionRevision records: a flag can point at revision 2 while
/// revision 3 exists, and no constraint can forbid it.
model ChapterRevision {
  id        String @id @default(cuid())
  chapterId String

  revisionNumber Int
  origin         ChapterRevisionOrigin
  content        String
  /// Counted at write time. A word count is one of the few things §9 lets a log
  /// carry, and CAL-103 sums it against the target length.
  wordCount      Int

  /// The generation that produced this revision (CAL-021), null for an edit
  /// and for a restoration. Same link, and the same reason, as
  /// AnalysisSectionRevision.generationId.
  generationId String?

  createdById String
  createdAt   DateTime @default(now())

  chapter    Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  // Restrict, as SourceTextVersion.editedBy and AnalysisSectionRevision
  // .createdBy already are: who asked for a version is the audit trail and must
  // not be silently orphaned. Deleting a project still works — it cascades this
  // table away before the reference is checked.
  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // SetNull: losing the trace must never cost the author a version of their
  // chapter. There is deliberately no CHECK pairing this column with
  // `origin = GENERATED` — a generated revision whose generation row was never
  // written is exactly the reconciliation case CAL-060 has to *report*, not a
  // state the schema refuses to store.
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  /// The passages of this revision a quality issue points at (CAL-021).
  qualityIssuePassages QualityIssuePassage[]
  /// The summaries made *from* this revision (CAL-055).
  summaries            ChapterSummaryRevision[]

  // Also the index the current revision is read by. Two concurrent writes
  // collide here as a unique violation instead of silently losing one.
  @@unique([chapterId, revisionNumber])
  // The target of QualityIssuePassage's revision key. It adds nothing to the
  // data — `id` is already unique — but it is what lets a passage reference the
  // revision *through* its chapter, so the chapter a passage names can never
  // disagree with the revision it anchors into. The pattern Character, Place
  // and Chapter already carry.
  @@unique([chapterId, id])
  @@map("chapter_revisions")
}

/// The two summaries of one chapter (CAL-055) — append-only, like the text they
/// are made from.
///
/// The pair is one row rather than two, because they are produced by one pass
/// over one revision and are only ever true together: a brief summary of
/// revision 4 sitting beside a detailed summary of revision 2 is a memory that
/// contradicts itself, and there is no constraint that could forbid it once the
/// two are separate rows.
///
/// **The foreign key names the revision, not the chapter.** A summary is made
/// *from* a state of the text, so `[chapterId, chapterRevisionId]` points at
/// ChapterRevision's own `@@unique([chapterId, id])` — which is what makes a
/// summary of another chapter's revision unstorable rather than merely
/// unlikely, the pattern ChapterOutline and QualityIssuePassage already use.
/// It is also the provenance CAL-134 reads: the summary is in doubt when the
/// chapter has a revision newer than the one named here, and that is a
/// comparison of two numbers, never a judgement about the prose.
///
/// There is deliberately no `origin` enum beside ChapterRevision's. This table
/// has one producer — the summarising mission — and `generationId` already
/// separates a generated row from one written by hand. A second member nothing
/// writes is a decision taken early and paid for twice.
///
/// The current summary of a chapter is the one with the highest revisionNumber,
/// and there is no `isCurrent` column, for the reason ChapterRevision records.
model ChapterSummaryRevision {
  id                String @id @default(cuid())
  chapterId         String
  chapterRevisionId String

  revisionNumber  Int
  /// Résumé court — ~50 words, the one every distant chapter is remembered by.
  briefSummary    String
  /// Résumé détaillé — ~200 words, carried for the nearest chapters only.
  detailedSummary String

  /// Counted at write time by `countWords`, never supplied by the caller. Word
  /// counts are among the few things §9 lets a log carry, which is what makes
  /// a compression pass observable without quoting a line of it.
  briefWordCount    Int
  detailedWordCount Int

  /// The generation that produced this row (CAL-021), null for a row written
  /// directly — a seed, a fixture, an import. Same link, and the same reason,
  /// as ChapterRevision.generationId.
  generationId String?

  createdById String
  createdAt   DateTime @default(now())

  // Cascade through the revision rather than through the chapter: there is one
  // path to Chapter and it is this one, so a chapter deletion still takes its
  // summaries (chapter -> chapter_revisions -> here, one subtree, one
  // statement) and no second foreign key can disagree with the first about
  // which chapter this row belongs to.
  chapterRevision ChapterRevision @relation(fields: [chapterId, chapterRevisionId], references: [chapterId, id], onDelete: Cascade)
  // Restrict, as ChapterRevision.createdBy already is: who asked for a version
  // is the audit trail and must not be silently orphaned. Deleting a project
  // still works — this table cascades away before the reference is checked.
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // SetNull: losing the trace must never cost the author their memory of a
  // chapter.
  generation      Generation?     @relation(fields: [generationId], references: [id], onDelete: SetNull)

  // Also the index the current summary is read by. Two concurrent summarising
  // passes collide here as a unique violation instead of silently losing one.
  @@unique([chapterId, revisionNumber])
  // PostgreSQL does not index a foreign key on its own, and the obsolescence
  // read walks this column.
  @@index([chapterRevisionId])
  @@map("chapter_summary_revisions")
}

/// The summary of one part (CAL-055) — append-only, and the level above the
/// chapter in the same hierarchy.
///
/// It exists so a novel's distant past keeps costing something. A writing
/// context can afford one summary per part where it cannot afford one per
/// chapter, so when the composer's ladder drops the farthest chapter summaries
/// the part still covers that span — which is the whole reason the hierarchy
/// has two levels rather than one.
///
/// **No provenance column, deliberately.** A part summary is made from its
/// chapters' current summaries, so naming one of them would name an arbitrary
/// member of a set, and naming all of them is a link table for a question
/// `createdAt` already answers: the part summary is in doubt when a chapter
/// summary under it is newer. The same reading SourceTextObsolescence uses one
/// level up, and for the same reason — provenance, never quality.
model PartSummaryRevision {
  id     String @id @default(cuid())
  partId String

  revisionNumber Int
  summary        String
  /// Counted at write time, like the chapter's.
  wordCount      Int

  generationId String?

  createdById String
  createdAt   DateTime @default(now())

  part       Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@unique([partId, revisionNumber])
  @@map("part_summary_revisions")
}

/// The three states of a narrative thread (CAL-020), in the command's own
/// order: opened, then carried forward, then paid off. "Still open" — the
/// read this task exists to serve — is every status but CLOSED, not OPEN
/// alone: a thread being actively continued has not been closed either.
enum ThreadStatus {
  OPEN // ouvert
  CONTINUED // poursuivi
  CLOSED // fermé

  @@map("thread_status")
}

/// One narrative thread (CAL-020) — a promise raised in one chapter, carried
/// by zero or more others, and, eventually, paid off in one. CAL-019 left this
/// table out on purpose: "Chapter is the spine... a thread opens at one
/// (CAL-020)", and Chapter already exposes @@unique([bibleId, id]) for this
/// table's links to hang off without a migration to that one.
///
/// `bibleId` travels down from Outline exactly as it does on ChapterOutline:
/// every reference to a chapter is a composite [bibleId, chapterId] against
/// Chapter's own [bibleId, id] key, which is what makes a thread of one
/// project citing another project's chapter unstorable rather than merely
/// unlikely.
///
/// No CHECK pairs status with closingChapterId. The pairings this schema
/// already writes (bibles_validation_check, analyses_validation_check) bind an
/// atomic action — stamped together by one code path, never independently.
/// Closing a thread is not that, and CAL-109's own wording asks to flag a
/// thread closed with no closing chapter, which is only a finding to surface
/// if the schema can hold it — the reading ChapterOutline's optional planning
/// attributes already establish, applied here instead of to a pairing CHECK
/// that would fight closingChapterId's SET NULL below.
model Thread {
  id        String @id @default(cuid())
  outlineId String
  bibleId   String

  label            String // libellé
  narrativePromise String // promesse narrative associée

  openingChapterId String // chapitre d'ouverture
  closingChapterId String? // chapitre de fermeture — set once closed, not before

  status ThreadStatus @default(OPEN)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("ThreadUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  outline        Outline  @relation(fields: [bibleId, outlineId], references: [bibleId, id], onDelete: Cascade)
  // NoAction, the pattern chapters_outlineId_partId_fkey already sets:
  // deleting a single chapter that a thread still opens at is refused, the
  // same protection "refuses to delete a part still holding chapters" gives.
  // A whole outline/bible/project cascade still empties both tables in the
  // same statement, because Thread and Chapter are both direct children of
  // Outline — the same subtree, not the two-subtree case that broke
  // focalCharacterId's NoAction in CAL-019. Probed against the real database,
  // not assumed, per the CAL-017 lesson; the integration suite runs both
  // paths.
  openingChapter Chapter  @relation("ThreadOpening", fields: [bibleId, openingChapterId], references: [bibleId, id], onDelete: NoAction, onUpdate: NoAction)
  // SET NULL on this column alone — ChapterOutline's focalCharacterId and
  // placeId pattern exactly, hand-written in the migration because Prisma
  // cannot express a column-scoped SET NULL. Deleting the closing chapter
  // forgets where the thread was said to end; it does not reopen it.
  closingChapter Chapter? @relation("ThreadClosing", fields: [bibleId, closingChapterId], references: [bibleId, id], onDelete: SetNull, onUpdate: NoAction)

  continuations ThreadContinuation[]

  // The target of ThreadContinuation's thread key.
  @@unique([bibleId, id])
  // A model may name a thread; business code resolves the primary key
  // (CLAUDE.md §6), the rule Character, Place, WorldRule, TimelineEvent and
  // Part already follow.
  @@unique([outlineId, label])
  // The read this task exists to serve: every thread not CLOSED, at any
  // instant.
  @@index([outlineId, status])
  // PostgreSQL does not index a foreign key on its own, and the NoAction and
  // SET NULL checks on chapter deletion each walk one of these.
  @@index([bibleId, openingChapterId])
  @@index([bibleId, closingChapterId])
  @@map("threads")
}

/// A chapter that carries a thread forward — "chapitres de poursuite", one row
/// per chapter. Immutable, like ChapterOutlineCharacter: a continuation is
/// added or removed, never edited, so it carries no updatedAt.
model ThreadContinuation {
  id      String @id @default(cuid())
  bibleId String

  threadId  String
  chapterId String

  createdAt DateTime @default(now())

  thread  Thread  @relation(fields: [bibleId, threadId], references: [bibleId, id], onDelete: Cascade)
  chapter Chapter @relation(fields: [bibleId, chapterId], references: [bibleId, id], onDelete: Cascade)

  // One continuation per chapter per thread. A rerun of the mission that finds
  // continuations collides here instead of doubling one.
  @@unique([threadId, chapterId])
  // Every thread a chapter carries forward — the read a repercussion analysis
  // (CAL-108) will make when that chapter moves.
  @@index([chapterId])
  @@map("thread_continuations")
}

/// The sixteen missions of CLAUDE.md §4.2, whose kebab-case identifiers CAL-051's
/// registry owns. An enum rather than free text because every indicator of
/// specification §17 that touches generation is a group-by on this column: a
/// typo would open a silent seventeenth category and put a hole in the numbers,
/// where an enum makes it a write error. Adding a mission is one member and one
/// migration, owned by the task that adds the mission — the same trade
/// CanonFactValidity records.
enum GenerationMission {
  ANALYZE_SOURCE_TEXT // analyser le texte source
  DETECT_CLICHE_RISKS // détecter les risques de clichés
  ASSESS_NOVEL_POTENTIAL // évaluer le potentiel romanesque
  REGENERATE_ANALYSIS_SECTION // régénérer une section de l'analyse
  PROPOSE_DIRECTIONS // proposer des directions
  REPLACE_DIRECTION // remplacer une direction écartée
  EVALUATE_DIRECTION // évaluer une direction
  COMBINE_DIRECTIONS // combiner des éléments de plusieurs directions
  CREATE_CHARACTER_SHEET // créer une fiche personnage
  BUILD_CHAPTER_OUTLINE // construire un plan de chapitre
  WRITE_SCENE // rédiger une scène
  EXTRACT_FACTS // extraire les faits
  CHECK_COHERENCE // contrôler la cohérence
  FIX_ISSUE // corriger un problème ciblé
  SUMMARIZE_CHAPTER // résumer un chapitre
  SUMMARIZE_PART // résumer une partie

  @@map("generation_mission")
}

/// The five states of a queued generation, in CAL-060's own words: en attente,
/// en cours, réussie, échouée, annulée. QUEUED is a real state and not an
/// absent row — a job Redis accepted and no worker ever picked up has to be
/// visible to the reconciliation task, and the wait before a worker takes it is
/// what separates queue latency from run time in `createdAt` → first attempt.
enum GenerationStatus {
  QUEUED // en attente
  RUNNING // en cours
  SUCCEEDED // réussie
  FAILED // échouée
  CANCELLED // annulée

  @@map("generation_status")
}

/// What one attempt is recorded as. Exactly the three members of
/// `GENERATION_STATUSES` in @calepin/shared/generation, which is the closed
/// list `runGenerationAttempt` already writes against; schema.test.ts pins the
/// two together by reading that file, so the column and the union cannot drift.
///
/// It is deliberately not GenerationStatus. An attempt is never queued — the
/// row is written by `start`, at the moment the work begins — and cancelling is
/// a decision about the task, not about a try.
enum GenerationAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("generation_attempt_status")
}

/// The eight categories of CLAUDE.md §7, mirrored from `ERROR_CATEGORIES` in
/// @calepin/shared/errors and pinned to it by schema.test.ts.
///
/// The category is an enum and the code beside it is not: §7 makes adding a
/// code a one-line diff in `errors/codes.ts`, and an enum would turn every such
/// line into a migration. The category list is closed, which is what makes the
/// operations dashboard's "taux d'erreur et causes principales" (CAL-067) a
/// typed group-by rather than a count of free-text strings.
/// Which of the three classes a generation's failure fell into (CAL-063), and
/// therefore what happens next: a transient one is retried after a short
/// backoff, a rate-limited one after a longer one, a permanent one never.
///
/// Exactly the three members of `GENERATION_FAILURE_CLASSES` in
/// @calepin/shared/generation, which is where the classification is decided;
/// schema.test.ts pins the two lists together by reading that file, so a fourth
/// class cannot be added on one side alone.
///
/// It is deliberately not derivable from `errorCategory`. A `PROVIDER` failure
/// is usually transient and `MODEL_OUTPUT_INVALID` is a `PROVIDER` failure that
/// is permanent — the flag that separates them lives on the error object, not on
/// the category, so the class has to be recorded rather than recomputed.
enum GenerationFailureClass {
  TRANSIENT // transitoire
  RATE_LIMITED // limite de débit
  PERMANENT // définitive

  @@map("generation_failure_class")
}

enum ErrorCategory {
  VALIDATION
  NOT_FOUND
  FORBIDDEN
  CONFLICT
  RATE_LIMIT
  PROVIDER
  TIMEOUT
  INTERNAL

  @@map("error_category")
}

/// One call to a model, from the point of view of the product: what was asked,
/// what it is for, and how to ask again.
///
/// **The row is the trace, and the trace is what makes a failure replayable.**
/// CLAUDE.md §7 states the guarantee — *a failed generation leaves the project
/// valid and replayable* — and `runGenerationAttempt` in
/// @calepin/shared/generation is the sequence that honours it. This table is
/// the persistence side of that port: `start` writes an attempt, `succeed`
/// appends the revision and completes the generation in one transaction, `fail`
/// completes it having written no result at all.
///
/// **What is not here is as deliberate as what is.** No token count, no cost,
/// no model and no duration: a generation that failed twice before succeeding
/// spent tokens three times, on possibly three different models once CAL-064's
/// fallback exists, so those columns are true of an *attempt* and would be a
/// lie here. The number of attempts is `MAX(attempt)` and the cost of a project
/// is a `SUM` over the attempts of its generations, failures included — which
/// is the only way indicator §17.8, average cost per project, is not an
/// undercount. A stored counter beside them would be the copy able to drift
/// that this schema refuses everywhere else.
///
/// **The indicators of specification §17 this table has to make computable**:
/// average cost per project (sum over attempts, grouped by `projectId`); the
/// average time between a project's creation and its first chapter (the
/// earliest `completedAt` of a succeeded WRITE_SCENE against
/// `Project.createdAt`); the full-regeneration rate (more than one succeeded
/// generation for one `(mission, targetId)`, or a project-wide mission run
/// twice). The others are read from the narrative tables and from QualityIssue.
model Generation {
  id        String @id @default(cuid())
  projectId String

  mission  GenerationMission
  /// The entity the mission produces or rewrites, in the kind its mission
  /// implies — a chapter for WRITE_SCENE, a character for
  /// CREATE_CHARACTER_SHEET — and null for a mission that targets the project
  /// as a whole, such as PROPOSE_DIRECTIONS.
  ///
  /// **Deliberately not a foreign key.** A generation row is an accounting and
  /// audit record: it has to survive the deletion of the chapter it wrote, or
  /// the cost already charged to a project changes retroactively when the
  /// author deletes a chapter. A typed reference would also mean one nullable
  /// column per entity kind — CAL-146 lists nine — and a nine-branch CHECK to
  /// keep exactly one of them set.
  targetId String?

  /// The identity of the *ask* — `generationIdempotencyKey` in
  /// @calepin/shared/generation, a SHA-256 over the mission, the project, the
  /// target and the resolved input, and the unique index below is what makes it
  /// binding (CAL-058).
  ///
  /// **Derived from this row's own columns, never supplied.**
  /// `reserveGeneration` computes it from the four values it is about to write,
  /// so no caller can hand over a key that disagrees with the row it names —
  /// the discipline `ProjectScope` and `RenderedPrompt` already use one layer
  /// up. A second delivery of the same ask collides here instead of opening a
  /// second generation and paying for it twice.
  ///
  /// **A digest rather than a rendering**, because `input` below may carry the
  /// author's own instruction: a key built by concatenating its parts would
  /// carry that instruction into this index, into every unique-violation
  /// payload and into any log line naming the key, which §9 forbids outright.
  ///
  /// The consequence for a caller is one sentence, and it is in the glossary:
  /// the replay payload names the versions it is built on. That is what makes a
  /// deliberate regeneration a different ask from the one before it, and a
  /// redelivered job the same one.
  idempotencyKey String

  /// The replay payload — *charge utile de reprise*. What business code passed
  /// to the mission: resolved identifiers, the options chosen, the author's own
  /// instruction. **Not** the composed prompt and **not** the model's answer.
  ///
  /// Replaying re-invokes the mission with this payload so the context composer
  /// (CLAUDE.md §5.8) recomposes against the *current* bible; a frozen prompt
  /// would replay a stale one and reproduce the failure it was meant to
  /// survive. It is one opaque column rather than readable fields on purpose:
  /// it may carry the author's instructions to the system, which §9 counts as
  /// literary content, so it is product data and must never reach a log line,
  /// an error payload or the operations view (CAL-067).
  input Json

  status GenerationStatus @default(QUEUED)

  /// A named step and its indicative percentage, as `reportProgress` inside a
  /// mission's `produce` last stated them (CAL-062) — "Composition du
  /// contexte", "Rédaction en cours", and so on. Display-only and advisory:
  /// nothing that decides this row's fate reads either column, which is why
  /// neither needs the audit block's discipline (§4.3's "authored by
  /// nobody" transitions, same as `status` itself). Cleared to null exactly
  /// when `claimGenerationAttempt` opens a new attempt, so a reload during
  /// attempt 2 never shows attempt 1's last step.
  progressStep    String?
  /// 0–100 — generations_progress_percent_check.
  progressPercent Int?

  /// Set exactly when the status is terminal — generations_completion_check.
  /// The wall-clock duration of the task is this minus createdAt, and the wait
  /// in the queue is the first attempt's startedAt minus createdAt; neither is
  /// stored, for the reason the missing counters above give.
  completedAt DateTime?

  /// The failure, classified and never described: the stable code and its
  /// category, the two fields §9 allows a failure to carry. Set together and
  /// only on a failure — generations_failure_check. The technical message and
  /// the provider payload stay out of the database entirely.
  errorCode     String?
  errorCategory ErrorCategory?

  /// Which of the three classes the last failure fell into, and therefore
  /// whether another attempt is owed (CAL-063). Present on a row waiting for an
  /// automatic retry and on a row that has failed for good; null on a fresh,
  /// running, succeeded or cancelled one — generations_retry_check.
  ///
  /// Recorded rather than recomputed: `retryable` is a property of the error
  /// object and may contradict its own category, so a reader cannot get the
  /// class back from `errorCategory`.
  ///
  /// It outlives `errorCode` on the retryable path, and that asymmetry is
  /// deliberate. The code is cleared when the row returns to `QUEUED` because the
  /// generation is open again and `generations_failure_check` reserves a code for
  /// a row that has actually failed; the class stays, because it is the only
  /// thing that says *why* the row is waiting rather than running.
  failureClass   GenerationFailureClass?
  /// When the next automatic attempt becomes due — the exponential backoff of
  /// CAL-063, expressed as a deadline on the row instead of a timer in a
  /// process. That is the whole point: a worker killed mid-backoff loses
  /// nothing, because the wait is in PostgreSQL like everything else that is
  /// true about this generation.
  ///
  /// A second producer since CAL-065: a claim refused for being over its
  /// project's or its owner's concurrency cap sets a near deadline here too,
  /// with `failureClass` left null — nothing failed, there was simply no slot
  /// free. `generations_retry_check` allows both shapes; only the pairing
  /// with a `failureClass` is CAL-063's own.
  ///
  /// Read by `listDeliverableGenerations` and by nothing else. Only the
  /// **automatic** redelivery honours it: an author replaying by hand, or asking
  /// the same thing again, is a decision and is never throttled by it.
  nextAttemptAt  DateTime?
  /// This row's own attempt ceiling, when it is not the default
  /// `MAX_GENERATION_ATTEMPTS` (CAL-063).
  ///
  /// Null for every generation nobody has replayed, which is almost all of them.
  /// `replayGeneration` sets it to the attempts already spent plus a fresh
  /// allowance, and without that a manual replay would be closed again as
  /// `GENERATION_ATTEMPTS_EXHAUSTED` by the very next sweep — the attempts are
  /// append-only, so the count never goes back down.
  attemptCeiling Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("GenerationUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  attempts                 GenerationAttempt[]
  /// What this generation produced, when it produced a versioned entity.
  analysisSectionRevisions AnalysisSectionRevision[]
  directionEvaluations     DirectionEvaluation[]
  chapterRevisions         ChapterRevision[]
  /// The summaries this generation produced (CAL-055).
  chapterSummaryRevisions  ChapterSummaryRevision[]
  partSummaryRevisions     PartSummaryRevision[]
  /// The quality issues this generation surfaced, when it was a CHECK_COHERENCE
  /// run (CAL-021).
  qualityIssues            QualityIssue[]

  // One open ask, one row (CAL-058). Also the lookup `reserveGeneration` reads
  // through when its insert conflicts, which is why the project leads: a key
  // already hashes its project, so this composite buys locality rather than
  // uniqueness the key does not already have.
  @@unique([projectId, idempotencyKey])
  // Cost and regeneration counting, both grouped on the leading columns; the
  // recent generations of a project are served by this index's first column
  // alone only for equality, which is why the listing gets its own below.
  @@index([projectId, mission, targetId])
  // The operations view (CAL-070) and the generation list: a project's
  // generations, newest first.
  @@index([projectId, createdAt])
  // The concurrency claim (CAL-065): how many of a project's generations are
  // RUNNING right now. Neither index above serves an equality filter on
  // `status` without also matching on `mission`/`targetId` or scanning
  // `createdAt` order, and this check runs on every claim.
  @@index([projectId, status])
  // The reconciliation task (CAL-060): everything still QUEUED or RUNNING past
  // its deadline, across every project.
  @@index([status, createdAt])
  // The other half of the same sweep since CAL-063: a QUEUED row is deliverable
  // either because it has been sitting there (the index above) or because its
  // backoff has elapsed. Two predicates on one column pair, so two indexes —
  // a sweep that runs every minute forever should not be a sequential scan of
  // every generation ever created.
  @@index([status, nextAttemptAt])
  @@map("generations")
}

/// One try at a generation — the row `runGenerationAttempt` writes before the
/// model is called, and completes after.
///
/// `@@unique([generationId, attempt])` is the constraint the shared port's
/// contract asks for in words: *`succeed` and `fail` are idempotent for a given
/// `(generationId, attempt)`*. BullMQ redelivers a job whose work already
/// completed, and here that redelivery collides with a unique violation instead
/// of writing a second cost line — which is CAL-064's own acceptance criterion,
/// that replaying a failed generation must not charge twice, expressed as a
/// database constraint rather than as care in the caller.
///
/// This is also where the model actually used is recorded, rather than on the
/// generation: a fallback (CAL-064) runs attempt 2 on another model, so one
/// column upstream would be false for one of the two. ADR-001's requirement
/// that a generation record its model and its prompt version is met here, and
/// met more finely.
model GenerationAttempt {
  id           String @id @default(cuid())
  generationId String

  /// 1 for the first try, as `AttemptContext.attempt` is.
  attempt Int

  /// The provider's model identifier, as it was called. Free text, and not an
  /// enum: the list belongs to the providers, changes without warning, and is
  /// declared per mission by CAL-051's registry.
  model         String
  /// The version of the prompt that ran (CAL-053) — `RenderedPrompt.version`,
  /// handed to `runGenerationAttempt` and written by `start`, **before** the
  /// model is called: ADR-001 wants a quality regression traceable to a prompt
  /// change, and the attempts that reveal one are the attempts that failed.
  ///
  /// Which prompt it was is this generation's own `mission` — each mission has
  /// exactly one prompt. Still nullable, because an attempt can be recorded
  /// outside the mission pipeline: a fixture, an import, a row written before
  /// the registry existed.
  promptVersion Int?

  /// Usage as the provider reported it, null while the attempt runs and when a
  /// call failed before returning any. Both non-negative —
  /// generation_attempts_usage_check.
  inputTokens      Int?
  outputTokens     Int?
  /// The cost this attempt is accounted for, in US dollars: the tokens above
  /// priced by the registry at the time of the call. `Decimal`, never a float —
  /// money summed in binary floating point stops adding up — and six decimals,
  /// finer than any provider's per-token rounding.
  estimatedCostUsd Decimal? @db.Decimal(12, 6)

  /// The duration the runner measured, from its injected clock, as
  /// `AttemptContext.durationMs` carries it. Kept beside the two timestamps
  /// rather than derived from them because it is what the runner observed:
  /// the timestamps are written by two separate statements, and their
  /// difference is the database's view of the attempt, not the attempt's.
  durationMs Int?

  status        GenerationAttemptStatus @default(RUNNING)
  errorCode     String?
  errorCategory ErrorCategory?

  startedAt   DateTime  @default(now())
  /// Set exactly when the attempt is no longer running —
  /// generation_attempts_completion_check.
  completedAt DateTime?

  /// When the worker holding this attempt stops being believed (CAL-058).
  ///
  /// A `RUNNING` row alone cannot tell a queue redelivering while the first run
  /// is still going from a worker that restarted after dying mid-call — and the
  /// two need opposite answers: leave it alone, or take it over. The lease is
  /// the difference. A claim finding a live one answers *in flight* and calls
  /// no provider; a claim finding an expired one closes the attempt as
  /// `GENERATION_INTERRUPTED`, **leaving its token columns untouched**, and
  /// opens the next attempt.
  ///
  /// Set exactly while the attempt is running —
  /// generation_attempts_lease_check. That equivalence is what makes the
  /// reclaim total: a `RUNNING` attempt with no lease would be a row no worker
  /// holds and no claim can ever take over, which is the permanent *état
  /// fantôme* the whole mechanism exists to make unrepresentable.
  ///
  /// Erring long is the safe direction. A late reclaim costs latency; an early
  /// one reclaims a healthy call and pays a provider twice for one answer.
  /// Renewing it while a long generation runs is CAL-060's, with the queue.
  leaseExpiresAt DateTime?

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  // The idempotency key. Also the index that reads a generation's attempts in
  // order, and that answers "how many attempts" without a scan.
  @@unique([generationId, attempt])
  // Cost and token totals per period, and per model, for the operations
  // dashboard (CAL-067).
  @@index([startedAt])
  @@map("generation_attempts")
}

/// The five families of check the coherence engine runs (CAL-135), in the
/// specification's own order. Closed and pinned by schema.test.ts: a sixth
/// family is a decision about the product, not a convenience.
enum QualityIssueCategory {
  FACTUAL_CONTINUITY // continuité factuelle
  PSYCHOLOGICAL_CONTINUITY // continuité psychologique
  STRUCTURE // structure
  STYLE // style
  ORIGINALITY // originalité

  @@map("quality_issue_category")
}

/// How much an issue matters, in decreasing order — the order the audit report
/// is ranked by (CAL-141) and the threshold the batch writer stops on
/// (CAL-198's *arrêt automatique en cas d'incohérence grave*).
///
/// The specification names no list, so this one is CAL-021's design, the
/// position RelationshipType already took. Three levels and not five: a scale
/// finer than "must be fixed / should be fixed / worth knowing" cannot be
/// applied consistently by five different check families, and an unusable
/// distinction becomes noise in the filter it exists to serve.
///
/// It is a rank, never a score. The specification forbids presenting a computed
/// number as a measure of quality or originality, and this column is a
/// three-valued judgement about one issue, not a total over a manuscript.
enum QualityIssueSeverity {
  CRITICAL // bloquant
  MAJOR // important
  MINOR // mineur

  @@map("quality_issue_severity")
}

/// The five statuses of the specification, which CAL-021's acceptance criterion
/// names one by one. Closed and pinned by schema.test.ts.
///
/// ACCEPTED and IGNORED are not the same thing and neither deletes the row: the
/// author accepts an issue as a deliberate choice they stand by, or sets it
/// aside without ruling on it. Keeping both is what lets the next audit
/// deduplicate against what has already been decided instead of proposing it
/// forever — the reasoning CanonFactStatus.REJECTED already records.
enum QualityIssueStatus {
  DETECTED // détecté
  ACCEPTED // accepté
  TO_FIX // à corriger
  FIXED // corrigé
  IGNORED // ignoré

  @@map("quality_issue_status")
}

/// One problem a check reported (CAL-135) — the *problème qualité* of the
/// backlog, which CLAUDE.md §4.3 named `Finding` before the model existed. The
/// backlog's identifier stands and the glossary row was amended, the way
/// CAL-016 resolved `CharacterSheet` into `Character`: one concept takes one
/// English word.
///
/// It hangs off the project, not off a chapter: the structure and originality
/// families judge the manuscript as a whole, and CAL-099 checks the bible
/// before a single chapter exists. What an issue is *about* is its passages,
/// which may be none.
///
/// Indicator §17.6, the number of contradictions detected, is a count over this
/// table; the filterable screen (CAL-142) reads the three enums, which is why
/// all three are columns and none is buried in prose.
model QualityIssue {
  id        String @id @default(cuid())
  projectId String

  category QualityIssueCategory
  severity QualityIssueSeverity
  status   QualityIssueStatus   @default(DETECTED)

  /// The identifier of the check that produced it, owned by CAL-135's registry
  /// of pluggable checks. Free text for the reason `errorCode` is: the list
  /// grows with the engine, in the engine's own file. It is what lets an
  /// incremental audit (CAL-141) recognise an issue it has already reported,
  /// and what makes a check's false-positive rate measurable.
  checkId String

  /// Why it is a problem, in the project's language. The specification forbids
  /// a bare verdict: every remark is argued and tied to a precise element.
  explanation String
  /// The correction the check proposes. Optional — a structural remark
  /// ("this chapter has no consequence") has no mechanical fix, and CAL-110's
  /// audit exists to surface the gap rather than to have it unstorable.
  proposedFix String?

  /// The CHECK_COHERENCE run that surfaced it, null for a deterministic check
  /// computed from the narrative memory without a model. It is the link that
  /// makes an issue traceable to the prompt version and the model that produced
  /// it, and it is enough until CAL-135 introduces the audit run itself.
  detectedByGenerationId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("QualityIssueUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  detectedByGeneration Generation? @relation(fields: [detectedByGenerationId], references: [id], onDelete: SetNull)

  passages QualityIssuePassage[]

  // The screen's own filter (CAL-142), and the count indicator §17.6 reads.
  @@index([projectId, status, severity])
  // The same list filtered by family, and the per-family audit summary.
  @@index([projectId, category])
  // The issues one run produced. PostgreSQL does not index a foreign key on its
  // own, and the SET NULL on generation deletion walks this path.
  @@index([detectedByGenerationId])
  @@map("quality_issues")
}

/// A passage an issue points at — *les passages concernés*, one row each.
///
/// **An anchor, never a copy of the prose.** The row names the chapter and, when
/// the check found a range rather than a whole chapter, the `ChapterRevision`
/// the range was found in and its character offsets into that revision's
/// content. Anchoring into a revision rather than into "the chapter" is what
/// keeps the offsets meaning what they meant: revisions are append-only, so the
/// text the check read is still there after the author edits, and a stale
/// anchor is visible as an old revision instead of silently sliding onto other
/// words. Storing the excerpt itself would be a second copy of the novel able
/// to drift from the first.
///
/// Three shapes, all intended: no passage row at all for an issue about the
/// manuscript or the bible as a whole; a row with null offsets for an issue
/// about a whole chapter, which is what a structural check reports (CAL-138);
/// a row with offsets for a located one, which is what opens the editor at the
/// right place on a click (CAL-142).
///
/// `chapterId` is not a copy able to drift from the revision's own: it is part
/// of the composite key referencing ChapterRevision(chapterId, id), so a
/// passage naming one chapter and a revision of another is rejected by
/// PostgreSQL.
model QualityIssuePassage {
  id      String @id @default(cuid())
  issueId String

  chapterId         String
  chapterRevisionId String?
  /// Character offsets into that revision's content, start inclusive and end
  /// exclusive. Set together, only alongside a revision, non-negative and
  /// ordered — quality_issue_passages_offsets_check.
  startOffset       Int?
  endOffset         Int?

  createdAt DateTime @default(now())

  issue           QualityIssue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  chapter         Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterRevision ChapterRevision? @relation(fields: [chapterId, chapterRevisionId], references: [chapterId, id], onDelete: Cascade)

  // The issues attached to one chapter — what the incremental audit (CAL-141)
  // reads to leave an unchanged chapter alone, and what the chapter screen
  // shows beside the text.
  @@index([chapterId])
  // A passage is added or removed with its issue, never edited, so it carries
  // no updatedAt — the reasoning ChapterOutlineCharacter and ThreadContinuation
  // already record.
  @@map("quality_issue_passages")
}

/// The formats the export engine renders (CAL-154). Markdown and DOCX are the
/// MVP (CAL-155, CAL-156); the other four are named now because CAL-154's whole
/// design constraint is that adding one costs a renderer and nothing else, and
/// a format the column cannot hold would cost a migration on top.
enum ExportFormat {
  MARKDOWN
  DOCX
  PDF
  EPUB
  HTML
  PLAIN_TEXT

  @@map("export_format")
}

/// The life of an asynchronous export (CAL-160). There is deliberately no
/// EXPIRED member: expiry is `expiresAt` compared to the current time, and a
/// status able to disagree with that timestamp would become the one consumers
/// trust — the reading Analysis and Bible already apply to their validation.
enum ExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED

  @@map("export_status")
}

/// One export of a manuscript (CAL-160, CAL-161).
///
/// It is not a `Generation`: no model is called, nothing is priced in tokens,
/// and the file it produces is the point. It is a background job with its own
/// small lifecycle, and sharing an enum with generations would have made every
/// later query about cost or missions have to exclude it.
///
/// Indicator §17.7, the export rate, is the share of projects with at least one
/// READY row here.
model Export {
  id            String @id @default(cuid())
  projectId     String
  requestedById String

  format ExportFormat
  status ExportStatus @default(QUEUED)

  /// The nine options of CAL-154 — title, author, chapter selection, table of
  /// contents, chapter numbers, title page, page breaks, metadata, notes — as
  /// the composer received them. Opaque here for the reason Generation.input
  /// is: the selection and the title are the author's, and the export engine
  /// owns their shape.
  options Json @default("{}")

  /// The object in the private bucket. Null until the file exists, and null
  /// again once it is purged (CAL-165) — which is why no CHECK ties it to
  /// READY: a purged export stays a READY export that can no longer be
  /// downloaded, and the history says so (CAL-161).
  storageKey String?
  /// Size and length of what was produced. Both are counts, the two measures §9
  /// explicitly allows beside identifiers, and both non-negative —
  /// exports_size_check.
  byteSize   Int?
  wordCount  Int?

  /// When the file stops being downloadable. Compared to the current time; see
  /// ExportStatus for why it is not a status.
  expiresAt DateTime?

  /// Set exactly when the export is no longer pending — exports_completion_check.
  completedAt DateTime?
  /// The failure, classified and never described, as a generation's is. Only on
  /// a failure — exports_failure_check.
  errorCode   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("ExportUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict, as every other author column in this schema is: who asked for a
  // copy of the manuscript is the audit trail. Deleting the project still
  // works — this table cascades away before the reference is checked.
  requestedBy User    @relation("ExportRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  // The export history of a project, newest first (CAL-161).
  @@index([projectId, createdAt])
  // Indicator §17.7: has this project ever produced a READY export.
  @@index([projectId, status])
  // PostgreSQL does not index a foreign key on its own, and the Restrict check
  // on user deletion walks this path (CAL-031).
  @@index([requestedById])
  @@map("exports")
}

/// Who can reach a published novel (CAL-202). PRIVATE is the default and the
/// state an unpublish returns to, which is what makes "la publication n'est
/// jamais automatique" the schema's default rather than a rule someone has to
/// remember.
enum PublicationVisibility {
  PRIVATE // privé
  UNLISTED // non répertorié
  PUBLIC // public

  @@map("publication_visibility")
}

/// The web publication of a novel (CAL-202, CAL-203) — one per project, since
/// the specification asks for a stable public address per novel.
///
/// The row existing does not mean the novel is published: `visibility` says
/// that, and it starts PRIVATE. Unpublishing sets it back to PRIVATE and stamps
/// `unpublishedAt`; it never deletes the row, because the address has to stay
/// reserved so a later republication does not hand someone else's novel the
/// link readers already have.
///
/// The presentation fields are here rather than read from the project: the
/// title and the author name shown to a reader are a publication decision, and
/// an author who renames their working project must not thereby rename a novel
/// that is already public.
model Publication {
  id        String @id @default(cuid())
  projectId String @unique

  /// The public address, stable for the life of the novel. Lowercase
  /// alphanumerics and single hyphens, 3 to 80 characters —
  /// publications_slug_check — so a link cannot be minted that a router or a
  /// share card would have to escape.
  slug String @unique

  visibility PublicationVisibility @default(PRIVATE)

  title           String
  authorName      String
  /// Résumé de présentation, and the cover in the private bucket.
  blurb           String?
  coverStorageKey String?

  /// The date the presentation page shows. Stamped the first time the novel
  /// leaves PRIVATE and never rewritten, so republishing after an unpublish
  /// does not silently redate a novel readers have already seen. A visible
  /// publication always has one — publications_published_check.
  firstPublishedAt DateTime?
  /// When it was last withdrawn. Kept beside the visibility rather than instead
  /// of it: the visibility is the access decision, this is the audit trail of
  /// the last withdrawal.
  unpublishedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String   @default("unattributed")
  version     Int      @default(1)
  updatedBy   User     @relation("PublicationUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The public catalogue, newest first — the listing UNLISTED exists to be
  // excluded from.
  @@index([visibility, firstPublishedAt])
  @@map("publications")
}
