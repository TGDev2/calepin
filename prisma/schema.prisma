generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects                 Project[]
  sourceTextVersionsEdited SourceTextVersion[]
  analysesValidated        Analysis[]
  analysisRevisionsCreated AnalysisSectionRevision[]
  analysisAnnotations      AnalysisAnnotation[]
  biblesValidated          Bible[]

  @@map("users")
}

enum ProjectStatus {
  DRAFT
  ANALYSIS_IN_PROGRESS
  DIRECTION_TO_CHOOSE
  BIBLE_TO_VALIDATE
  OUTLINE_IN_PROGRESS
  WRITING_IN_PROGRESS
  REVISION
  COMPLETED
  PUBLISHED
  ARCHIVED

  @@map("project_status")
}

/// The four target lengths of the specification. The word ranges behind the
/// three presets — short 30-45k, standard 50-80k, long 80-110k — and the
/// chapter count derived from them belong to CAL-043; this schema stores the
/// choice, not its interpretation. CUSTOM carries its value in
/// Project.targetWordCount.
enum TargetLength {
  SHORT
  STANDARD
  LONG
  CUSTOM

  @@map("target_length")
}

enum FreedomLevel {
  LOW
  BALANCED
  HIGH

  @@map("freedom_level")
}

model Project {
  id              String        @id @default(cuid())
  userId          String
  title           String
  language        String        @default("fr")
  targetLength    TargetLength  @default(STANDARD)
  /// Set if and only if targetLength is CUSTOM, and then strictly positive.
  /// A preset stores no number: the enum already names its range, and a second
  /// column able to contradict it would become the one consumers trust.
  /// Enforced by projects_custom_target_word_count_check, which Prisma cannot
  /// express — see the add_project_custom_target_word_count migration.
  targetWordCount Int?
  targetAudience  String        @default("Grand public")
  freedomLevel    FreedomLevel  @default(BALANCED)
  status          ProjectStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText         SourceText?
  analysis           Analysis?
  creativeDirections CreativeDirection[]
  bible              Bible?

  // The dashboard lists one user's projects, most recently modified first
  // (CAL-065), and filters that list by status. No index on userId alone:
  // a composite btree already serves any lookup keyed on its leading column.
  @@index([userId, updatedAt])
  @@index([userId, status])
  @@map("projects")
}

model SourceText {
  id        String   @id @default(cuid())
  projectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions SourceTextVersion[]

  @@map("source_texts")
}

model SourceTextVersion {
  id            String   @id @default(cuid())
  sourceTextId  String
  versionNumber Int
  content       String
  wordCount     Int
  language      String   @default("fr")
  editedById    String
  createdAt     DateTime @default(now())

  sourceText        SourceText                @relation(fields: [sourceTextId], references: [id], onDelete: Cascade)
  editedBy          User                      @relation(fields: [editedById], references: [id], onDelete: Restrict)
  analysisRevisions AnalysisSectionRevision[]

  @@unique([sourceTextId, versionNumber])
  @@map("source_text_versions")
}

/// The seventeen sections of the narrative diagnostic, in the order the
/// specification lists them. The list is closed and pinned by schema.test.ts:
/// adding a section is a decision about the product, not a convenience.
enum AnalysisSection {
  FACTUAL_SUMMARY // résumé factuel
  PREMISE // prémisse
  MAIN_CONFLICT // conflit principal
  NARRATIVE_PROMISE // promesse du récit
  THEMES // thèmes
  CHARACTERS // personnages identifiés
  RELATIONSHIPS // relations
  POINT_OF_VIEW // point de vue
  TENSE // temps verbal
  TONE // tonalité
  SINGULAR_ELEMENTS // éléments singuliers
  AMBIGUITIES // ambiguïtés
  OPEN_QUESTIONS // questions non résolues
  ELEMENTS_TO_PRESERVE // éléments à préserver
  WEAKNESSES // fragilités
  CLICHE_RISKS // risques de clichés
  DEVELOPMENT_POTENTIAL // potentiel de développement

  @@map("analysis_section")
}

/// Fait explicite versus interprétation, per the glossary in CLAUDE.md §4.3.
/// The column is NOT NULL, which is what makes an unmarked element unstorable
/// even through a direct SQL insert — the marker is carried by the data, never
/// by the presentation.
enum AnalysisElementKind {
  FACTUAL
  INTERPRETATION

  @@map("analysis_element_kind")
}

/// Where a section revision came from. Two members, because that is the
/// distinction the version history has to show (CAL-147): a generation, or a
/// human edit. A section the author rewrote entirely is still EDITED.
enum AnalysisRevisionOrigin {
  GENERATED
  EDITED

  @@map("analysis_revision_origin")
}

/// The narrative diagnostic of a project's source text — one per project.
/// The backlog's content line calls this NarrativeAnalysis; the identifier is
/// Analysis, fixed by the glossary in CLAUDE.md §4.3, which also names
/// AnalysisElement.kind. This model holds the validation and nothing else: the
/// content lives in the section revisions.
model Analysis {
  id            String    @id @default(cuid())
  projectId     String    @unique
  /// The validation status is this timestamp. It is set together with
  /// validatedById and never one without the other — analyses_validation_check,
  /// which Prisma cannot express, see the add_narrative_analysis migration.
  /// A status enum beside these two columns could only contradict them.
  validatedAt   DateTime?
  validatedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict, not Prisma's SetNull default for an optional relation: nulling
  // validatedById while validatedAt stands would break
  // analyses_validation_check, so deleting the author would fail anyway — with
  // a check violation instead of the referential error that names the cause.
  validatedBy User?   @relation(fields: [validatedById], references: [id], onDelete: Restrict)

  sectionRevisions AnalysisSectionRevision[]

  @@map("analyses")
}

/// One version of one section. The section is the unit of regeneration
/// (CAL-077), so it is the unit of versioning: a new revision of `THEMES`
/// leaves the sixteen other sections' rows — and every annotation hanging off
/// them — untouched, which a whole-analysis snapshot could not do.
///
/// The table is append-only. The current revision of a section is the one with
/// the highest revisionNumber; there is deliberately no `isCurrent` column,
/// since a flag can point at revision 2 while revision 3 exists and no
/// constraint can forbid it.
model AnalysisSectionRevision {
  id                  String                 @id @default(cuid())
  analysisId          String
  section             AnalysisSection
  revisionNumber      Int
  origin              AnalysisRevisionOrigin
  /// The version of the source text this revision was produced against. Held
  /// per revision rather than per analysis: a section regenerated after the
  /// author edited the source text read a different version from the sections
  /// around it, and that is exactly what CAL-046 needs in order to name the
  /// sections a source-text edit made obsolete.
  sourceTextVersionId String
  createdById         String
  createdAt           DateTime               @default(now())

  analysis          Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  // Restrict on both references, as SourceTextVersion.editedBy already does:
  // the record of which text a revision read, and of who asked for it, is the
  // audit trail and must not be silently orphaned. Deleting a project still
  // works — it cascades this table away before the references are checked.
  sourceTextVersion SourceTextVersion @relation(fields: [sourceTextVersionId], references: [id], onDelete: Restrict)
  createdBy         User              @relation(fields: [createdById], references: [id], onDelete: Restrict)

  elements AnalysisElement[]

  // Also the index that answers "the current revision of each section of this
  // analysis". Two concurrent regenerations of one section collide here as a
  // unique violation instead of silently losing one of them.
  @@unique([analysisId, section, revisionNumber])
  @@map("analysis_section_revisions")
}

/// One assertion about the source text. The same shape carries all seventeen
/// sections, whether the section produces a single element (résumé factuel,
/// point de vue) or a list of them (thèmes, risques de clichés). How many
/// elements a section may hold is a narrative rule and belongs to the domain's
/// output schema (CAL-070), not to a database constraint.
///
/// Immutable, like the revision that owns it, so it carries no updatedAt and no
/// author of its own: both would be copies of the revision's, able to drift
/// from it and unable to be corrected.
model AnalysisElement {
  id                String              @id @default(cuid())
  sectionRevisionId String
  position          Int
  kind              AnalysisElementKind
  /// The short heading a listed section has and a paragraph section does not —
  /// a theme's name, a character's name, the point of view, the tense.
  label             String?
  /// The element itself: one assertion, in the project's language.
  statement         String
  /// The passage of the source text that supports the element. CAL-071 owns
  /// when it is mandatory; this column is its home. It is not enforced by a
  /// CHECK here because the answer is section-dependent — a factual summary of
  /// the whole text is supported by no single passage.
  evidence          String?

  sectionRevision AnalysisSectionRevision @relation(fields: [sectionRevisionId], references: [id], onDelete: Cascade)
  annotations     AnalysisAnnotation[]

  @@unique([sectionRevisionId, position])
  @@map("analysis_elements")
}

/// A free note the author attaches to one element. Mutable, unlike everything
/// above it, so it carries its own timestamps.
model AnalysisAnnotation {
  id        String   @id @default(cuid())
  elementId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  element AnalysisElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([elementId])
  @@map("analysis_annotations")
}

/// Where a creative direction came from. Three members, since that is the
/// distinction CAL-015's origin requirement draws: an AI proposal taken as is,
/// one the user edited, and one the user wrote from nothing. Mirrors
/// AnalysisRevisionOrigin's shape, not its members — a direction the user
/// rewrote from a proposal is still worth telling apart from one they started
/// blank, which GENERATED / EDITED alone cannot.
enum DirectionOrigin {
  PROPOSED // proposée
  EDITED // modifiée par l'utilisateur
  USER_WRITTEN // rédigée par l'utilisateur

  @@map("direction_origin")
}

/// One novelistic direction a project could take. Several coexist per project —
/// CAL-015 asks for at least three to be explorable side by side — and at most
/// one is canonical at a time. Flat by design: the backlog's own rationale for
/// this task is a well-defined, single-table shape, so a list-shaped attribute
/// (nouveaux enjeux, personnages à introduire, ...) is a Postgres array column
/// rather than a child table.
model CreativeDirection {
  id        String @id @default(cuid())
  projectId String

  workingTitle             String // titre de travail
  developedPremise         String // prémisse développée
  dominantGenre            String // genre dominant
  mainConflict             String // conflit principal
  protagonistArc           String // trajectoire du protagoniste
  newStakes                String[] // nouveaux enjeux
  charactersToIntroduce    String[] // personnages à introduire
  endingNature             String // nature de la fin
  mainRisks                String[] // risques principaux
  elementsKeptFromSource   String[] // éléments conservés du texte source
  elementsTransformed      String[] // éléments transformés
  novelPotentialAssessment String // évaluation du potentiel romanesque

  /// The marker the backlog asks for. At most one true row per project is
  /// enforced by creative_directions_canonical_per_project_key, a partial
  /// unique index Prisma cannot express here — see the
  /// add_creative_direction migration.
  isCanonical Boolean         @default(false)
  origin      DirectionOrigin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("creative_directions")
}

/// The narrative bible — the reference every later generation reads from. One
/// per project.
///
/// It holds no content of its own. The identity and style sections are their
/// own rows, and characters, places and world rules are their own tables,
/// because a generation context is composed of the few elements it needs and
/// never of the whole bible (CLAUDE.md §5.8). One row per element, and typed
/// markers to filter rows on, are what make that selection possible without
/// reading the prose first; a JSON section column would have forced reading all
/// of a section to obtain one field of it.
model Bible {
  id String @id @default(cuid())

  projectId     String    @unique
  /// The validation status is this timestamp. It is set together with
  /// validatedById and never one without the other — bibles_validation_check,
  /// which Prisma cannot express, see the add_narrative_bible migration. Same
  /// shape as Analysis: a status enum beside these two columns could only
  /// contradict them. CAL-100 owns the action and the named version it creates.
  validatedAt   DateTime?
  validatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict, as Analysis.validatedBy already is: nulling validatedById while
  // validatedAt stands would break bibles_validation_check, so the delete would
  // fail anyway — with a check violation instead of the referential error that
  // names the cause.
  validatedBy User?   @relation(fields: [validatedById], references: [id], onDelete: Restrict)

  identity      BibleIdentity?
  style         BibleStyle?
  characters    Character[]
  relationships Relationship[]
  places        Place[]
  worldRules    WorldRule[]

  @@map("bibles")
}

/// The identity section of the bible (CAL-088).
///
/// Its own row rather than nine more columns on Bible: it is produced by its
/// own mission, regenerated alone and locked alone, and a row that exists means
/// a section that has been produced — which is what lets every column be NOT
/// NULL instead of nine nulls each reader would have to interpret.
///
/// Two of the eleven fields CAL-088 names are deliberately absent. Longueur
/// cible and public already live on Project, chosen by the author before any
/// generation; restating them here would create the second column able to
/// contradict the first that CAL-012 recorded as a lesson. The mission reads
/// them from the project and stays consistent with them.
model BibleIdentity {
  id      String @id @default(cuid())
  bibleId String @unique

  workingTitle     String // titre de travail
  genre            String // genre
  subGenre         String // sous-genre
  tone             String // tonalité
  narrativePromise String // promesse narrative
  themes           String[] @default([]) // thèmes
  counterThemes    String[] @default([]) // contre-thèmes
  centralQuestion  String // question centrale
  /// CAL-088 calls it "type de fin"; the identifier is the one
  /// CreativeDirection already uses for the same concept one stage earlier.
  endingNature     String

  /// The lock. A timestamp is the state — there is no isLocked boolean beside
  /// it able to disagree. CAL-095 makes it bite before a generation runs.
  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@map("bible_identities")
}

/// The style section of the bible (CAL-089), and the section a chapter-writing
/// context reads most often — which is the other reason it is a row of its own
/// rather than nine columns on a wider table.
///
/// Every field holds an operational constraint, not a decorative adjective:
/// that requirement is CAL-089's and it is about the wording the mission
/// produces, so the column type is the same free text as the rest.
model BibleStyle {
  id      String @id @default(cuid())
  bibleId String @unique

  pointOfView        String // point de vue
  focalization       String // focalisation
  tense              String // temps verbal
  languageRegister   String // niveau de langue
  descriptiveDensity String // densité descriptive
  pacing             String // rythme
  dialogueBalance    String // place du dialogue
  recurringMotifs    String[] @default([]) // motifs récurrents
  elementsToAvoid    String[] @default([]) // éléments stylistiques à éviter

  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@map("bible_styles")
}

/// How much of the cast a character is. Not a duplicate of `role`, which stays
/// the specification's free-text field naming the narrative function: this is
/// the typed marker rows are filtered on.
///
/// Without it CAL-090's own acceptance criterion — every *main* character has
/// an explicit contradiction and a need distinct from their desire — is not
/// checkable, and the context composer has no way to choose whose sheet to read
/// short of reading every sheet.
enum CharacterImportance {
  MAIN // personnage principal
  SECONDARY // personnage secondaire
  MINOR // personnage mineur

  @@map("character_importance")
}

/// One member per field of the character sheet, so that a single field can be
/// locked (CAL-095, CAL-097) without a lock naming a field no column answers
/// to. schema.test.ts pins this list against Character's own fields, so the two
/// cannot drift.
enum CharacterField {
  NAME
  AGE
  ROLE
  IMPORTANCE
  APPEARANCE
  INITIAL_SITUATION
  APPARENT_DESIRE
  DEEP_NEED
  FEAR
  CONTRADICTION
  SECRET
  PAST
  PLANNED_ARC
  SPEECH_STYLE
  HELD_KNOWLEDGE
  ELEMENTS_TO_PRESERVE

  @@map("character_field")
}

/// One character, which is also their sheet. CLAUDE.md §4.3 named the concept
/// `CharacterSheet`; the identifier is `Character`, fixed by the backlog's own
/// content line and by CAL-016's command, and the glossary row was amended
/// rather than left to carry two names for one thing.
///
/// Every field but the name is optional. The acceptance criterion is that a
/// complete sheet is *persistable*, not that an incomplete one is refused: the
/// sheet is filled progressively and CAL-097 saves as the author types. What a
/// generated sheet must contain is a narrative rule and belongs to CAL-090's
/// output schema, the same boundary AnalysisElement draws with CAL-070.
model Character {
  id      String @id @default(cuid())
  bibleId String

  name               String // nom
  /// An integer, not free text: CAL-093 must reject an impossible age
  /// arithmetically ("34 years old, and 12 thirty years ago") and CAL-017
  /// computes an age at an event. Nullable, because it can be genuinely unknown
  /// while the bible is being written; bounded below by characters_age_check
  /// and deliberately not above, since a character can be eight hundred.
  age                Int?
  role               String? // rôle
  importance         CharacterImportance @default(SECONDARY)
  appearance         String? // apparence utile au récit
  initialSituation   String? // situation initiale
  apparentDesire     String? // désir apparent
  deepNeed           String? // besoin profond
  fear               String? // peur
  contradiction      String? // contradiction
  secret             String? // secret
  past               String? // passé
  plannedArc         String? // évolution prévue
  speechStyle        String? // manière de parler
  /// Connaissances détenues, as the author writes them on the sheet. The
  /// checkable form — which character knows which atomic fact — is CAL-018's
  /// CanonFact, derived from here by CAL-094; this column is its source, not a
  /// competing copy of it.
  heldKnowledge      String[]            @default([])
  /// Éléments à ne pas modifier: what the author declares must not change. It
  /// states the intent; `lockedAt` and `lockedFields` below enforce it. Both
  /// exist because the specification asks for both, and they are not
  /// interchangeable — a declaration no mechanism reads would be decoration.
  elementsToPreserve String[]            @default([])

  /// The whole sheet is locked when this is set.
  lockedAt     DateTime?
  /// The fields locked individually (CAL-097). An enum array rather than a
  /// child table: it travels with the row, so the context composer and
  /// CAL-095's guard read the lock state on a read they were making anyway,
  /// where a child table would put a join in front of the query the product
  /// runs most. A field is locked when the row is locked or the field is listed
  /// here.
  lockedFields CharacterField[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  outgoingRelationships Relationship[] @relation("RelationshipSource")
  incomingRelationships Relationship[] @relation("RelationshipTarget")

  // The target of Relationship's two composite foreign keys. It is what makes a
  // relationship between two bibles unstorable rather than merely unlikely.
  @@unique([bibleId, id])
  // A model may name a character; business code resolves the primary key
  // (CLAUDE.md §6). That resolution needs the name to be unique inside a bible,
  // so it is a constraint rather than a hope — and it also means a rerun of the
  // character mission cannot silently produce a second sheet for the same name.
  @@unique([bibleId, name])
  // "The main characters of this bible", without reading a single sheet.
  @@index([bibleId, importance])
  @@map("characters")
}

/// The nature of a tie. The specification names no list, so this one is
/// CAL-016's design: broad enough that a novel's ties land in it, with OTHER
/// and the free-text label carrying what it does not name. Adding a member
/// later is a one-line migration; loosening the column to free text would not
/// be.
enum RelationshipType {
  FAMILY // famille
  ROMANTIC // amour
  FRIENDSHIP // amitié
  PROFESSIONAL // travail
  MENTORSHIP // mentorat
  ALLIANCE // alliance
  RIVALRY // rivalité
  HOSTILITY // hostilité
  OTHER // autre, précisé par label

  @@map("relationship_type")
}

/// A directed edge between two characters of the same bible: one row per
/// direction, and the reverse direction is a second row that may say something
/// else. That is what makes "A knows about B what B ignores" representable
/// (CAL-091).
///
/// The mirror row is never created automatically, and that is a decision rather
/// than an omission: CAL-099 has to *detect a missing symmetric relation*, and
/// a schema that writes the mirror itself can never produce one to detect.
///
/// bibleId is not a copy able to drift from the characters' own. It is part of
/// both foreign keys, which reference Character(bibleId, id), so a row whose
/// bible disagrees with its characters — or whose two characters come from
/// different bibles — is rejected by PostgreSQL. It is carried here so that the
/// relationship graph of a bible is one query rather than a join through
/// characters.
model Relationship {
  id      String @id @default(cuid())
  bibleId String

  fromCharacterId String
  toCharacterId   String
  type            RelationshipType
  /// The tie in the project's language, written from the source character's
  /// side: "père de", "ancienne associée de".
  label           String
  /// What holds from the source character's side only — what A believes, knows
  /// or feels about B. The asymmetry is written here; its checkable form is
  /// CAL-018's per-character knowledge of an atomic fact.
  description     String?

  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bible         Bible     @relation(fields: [bibleId], references: [id], onDelete: Cascade)
  fromCharacter Character @relation("RelationshipSource", fields: [bibleId, fromCharacterId], references: [bibleId, id], onDelete: Cascade)
  toCharacter   Character @relation("RelationshipTarget", fields: [bibleId, toCharacterId], references: [bibleId, id], onDelete: Cascade)

  // Two characters may be tied in several ways at once — family and rivalry —
  // so the type is part of the key. It also turns a rerun of the relationship
  // mission into a unique violation instead of a duplicated edge.
  @@unique([fromCharacterId, toCharacterId, type])
  // The relations pointing *at* a character. Its outgoing ones are already
  // served by the unique index above, whose leading column they are.
  @@index([toCharacterId])
  // The whole graph of a bible, in one query.
  @@index([bibleId])
  @@map("relationships")
}

/// A place of the novel. Named uniquely inside its bible for the same reason a
/// character is: a chapter outline will reference a place the model named, and
/// business code resolves that name to a primary key (CLAUDE.md §6, CAL-102).
model Place {
  id      String @id @default(cuid())
  bibleId String

  name        String // nom
  description String?

  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@unique([bibleId, name])
  @@map("places")
}

/// A rule of the novel's world.
///
/// `limits` is required of anything marked supernatural —
/// world_rules_supernatural_limits_check, hand-written in the migration —
/// because CAL-092's imperative is that no out-of-norm capability may be
/// declared without explicit boundaries. That requirement is not decorative: a
/// power with no stated limit, cost or failure condition is exactly what makes
/// a resolution by convenience undetectable later (CAL-159).
model WorldRule {
  id      String @id @default(cuid())
  bibleId String

  /// A short handle, so a locked rule can be cited by name when it blocks a
  /// generation (CAL-095, CAL-115).
  name              String
  statement         String
  /// Covers any out-of-norm capability, not only the supernatural in the strict
  /// sense — CAL-092's own wording is "élément surnaturel ou capacité hors
  /// norme".
  isSupernatural    Boolean  @default(false)
  limits            String[] @default([]) // limites — non-empty whenever isSupernatural
  costs             String[] @default([]) // coûts
  failureConditions String[] @default([]) // conditions d'échec

  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bible Bible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@unique([bibleId, name])
  @@map("world_rules")
}
