{
  "name": "calepin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @calepin/web dev",
    "dev:services": "docker compose up -d",
    "build": "pnpm --filter @calepin/web build",
    "start": "pnpm --filter @calepin/web start",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p prisma/tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @calepin/web test:e2e",
    "db:seed": "prisma db seed",
    "prompt:diff": "tsx packages/ai/scripts/prompt-diff.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@calepin/ai": "workspace:*",
    "@calepin/manuscript": "workspace:*",
    "@calepin/outline": "workspace:*",
    "@calepin/shared": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.21.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tsx": "^4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
